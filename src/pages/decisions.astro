---
import Base from '../layouts/Base.astro';
import OpsNav from '../components/OpsNav.astro';
import { adrs } from '../data/ops';
---

<Base
  title="Architecture decisions"
  description="Architecture decision records for Rafif Dzaky Daniswara's portfolio: why a homelab, why Cloudflare Tunnel, how deploys and the CSP work, and what each choice costs."
  current="other"
>
  <OpsNav current="decisions" />
  <header class="wrap page-head">
    <p class="kicker">Architecture decision records</p>
    <h1>Why this site is built the way it is</h1>
    <p class="lede">
      Every choice here gave something up. These records say what I chose, what I rejected, and what it costs me, so the
      next person (or me in a year) doesn't have to guess.
    </p>
  </header>

  <div class="wrap adrs">
    {
      adrs.map((a) => (
        <article class="adr ticket" id={a.id.toLowerCase()} aria-labelledby={`${a.id}-t`}>
          <p class="adr-meta">
            <span class="adr-id">{a.id}</span>
            <span class={`st st--${a.status.toLowerCase()}`}>{a.status}</span>
            <span>{a.date}</span>
          </p>
          <h2 id={`${a.id}-t`}>{a.title}</h2>
          <dl>
            <div>
              <dt>Context</dt>
              <dd>{a.context}</dd>
            </div>
            <div>
              <dt>Decision</dt>
              <dd class="dec">{a.decision}</dd>
            </div>
          </dl>
          <div class="tradeoffs">
            <div>
              <p class="lbl lbl--pro">+ Gains</p>
              <ul>
                {a.pros.map((x) => (
                  <li>{x}</li>
                ))}
              </ul>
            </div>
            <div>
              <p class="lbl lbl--con">− Costs</p>
              <ul>
                {a.cons.map((x) => (
                  <li>{x}</li>
                ))}
              </ul>
            </div>
          </div>
          <p class="lbl">Considered instead</p>
          <ul class="alts">
            {a.alternatives.map((x) => (
              <li>{x}</li>
            ))}
          </ul>
        </article>
      ))
    }
  </div>
</Base>

<style>
  .page-head {
    padding-block: var(--s-6);
  }

  h1 {
    margin-top: var(--s-3);
    font-size: var(--step-4);
    max-width: 18ch;
  }

  .lede {
    margin-top: var(--s-4);
  }

  .adrs {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--s-5);
    padding-bottom: var(--s-9);
  }

  .adr {
    display: flex;
    flex-direction: column;
    gap: var(--s-3);
    padding: var(--s-5) var(--s-6);
  }

  .adr-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-3);
    font: 400 0.8rem / 1.3 var(--font-mono);
    color: var(--muted);
  }

  .adr-id {
    padding: 0.1rem 0.4rem;
    border-radius: 3px;
    background: var(--ink);
    color: var(--paper);
  }

  .st--accepted {
    color: var(--ok-ink);
  }

  .st--accepted::before {
    content: '● ';
  }

  .adr h2 {
    font-size: var(--step-1);
  }

  dl {
    display: grid;
    gap: var(--s-3);
  }

  dt,
  .lbl {
    font: 500 0.72rem / 1.3 var(--font-mono);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
  }

  dd {
    margin-top: var(--s-1);
    color: var(--muted);
  }

  dd.dec {
    color: var(--ink);
    font-weight: 550;
  }

  .tradeoffs {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--s-4);
    padding: var(--s-3) var(--s-4);
    border-radius: var(--radius);
    background: var(--paper);
  }

  .lbl--pro {
    color: var(--ok-ink);
  }

  .lbl--con {
    color: var(--stamp);
  }

  .tradeoffs ul,
  .alts {
    display: grid;
    gap: var(--s-1);
    margin-top: var(--s-1);
    padding-left: 1.1rem;
    font-size: 0.95rem;
  }

  .alts {
    margin-top: calc(-1 * var(--s-2));
    color: var(--muted);
  }

  @media (max-width: 60rem) {
    .adrs {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 36rem) {
    .adr {
      padding: var(--s-5);
    }
    .tradeoffs {
      grid-template-columns: 1fr;
    }
  }
</style>
