---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found" description="This page could not be found. Explore Rafif Dzaky Daniswara's work, homelab and research instead." current="other" noindex>
  <section class="wrap nf">
    <p class="kicker">HTTP 404 · gate not found</p>
    <h1>This flight doesn't exist.</h1>
    <p class="lede">The page may have moved. Work, homelab and contact are one step away.</p>
    <p class="actions">
      <a class="btn btn--primary" href="/">Home</a>
      <a class="btn" href="/#work">Work</a>
      <a class="btn" href="/#contact">Contact</a>
    </p>
  </section>
</Base>

<style>
  .nf {
    min-height: 60vh;
    padding-block: var(--s-9);
  }
  h1 {
    margin-top: var(--s-4);
    font-size: var(--step-4);
    max-width: 18ch;
  }
  .lede {
    margin-top: var(--s-4);
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3);
    margin-top: var(--s-6);
  }
</style>
