---
import Base from '../layouts/Base.astro';
import Window from '../components/os/Window.astro';
import HomelabMap from '../components/HomelabMap.astro';
import { builtNow, notes, roadmap, stateLabel } from '../data/homelab';

const counts = roadmap.flatMap((p) => p.items).reduce(
  (acc, i) => ((acc[i.state] = (acc[i.state] ?? 0) + 1), acc),
  {} as Record<string, number>,
);
---

<Base
  title="Homelab"
  description="Explore Rafif Dzaky Daniswara's Proxmox homelab with Terraform, Ansible, DNS, Tailscale and Docker. Running and planned work are clearly labelled."
  current="homelab"
>
  <Window title="Files · ~/homelab" as="p" id="lab" bodyClass="page-top">
    <p class="kicker">Personal project · not production · one physical host</p>
    <h1>A single-host lab for the things I don't run at work yet</h1>
    <p class="lede">
      I use a Proxmox homelab to practise infrastructure as code, DNS, networking, remote access and service operations.
      It's separate from my professional work. Everything here is labelled by what actually runs today.
    </p>
  </Window>

  <Window title="Monitoring · homelab map" id="map" bodyClass="pad">
    <HomelabMap />
  </Window>

  <Window title="Deploys · running now" id="now" bodyClass="pad">
    <ul class="now">
      {
        builtNow.map((b) => (
          <li class="panel">
            <p class="panel-h">
              <span class={`status status--${b.state}`}>{stateLabel[b.state]}</span>
              <span class="mono">{b.id}</span>
            </p>
            <div class="panel-b">
              <h3>{b.name}</h3>
              <p>{b.summary}</p>
            </div>
          </li>
        ))
      }
    </ul>
  </Window>

  <Window title="Terminal · things that broke, and why" id="notes" bodyClass="pad">
    <ol class="notes">
      {
        notes.map((n) => (
          <li class="panel">
            <p class="panel-h">
              <span>{n.title}</span>
              <span class:list={['tag', n.state === 'resolved' ? 'ok' : 'warn']}>
                {n.state === 'resolved' ? 'resolved' : 'investigating'}
              </span>
            </p>
            <dl class="panel-b">
              <div><dt>Symptom</dt><dd>{n.symptom}</dd></div>
              <div><dt>Cause</dt><dd>{n.cause}</dd></div>
              <div><dt>Takeaway</dt><dd>{n.lesson}</dd></div>
            </dl>
          </li>
        ))
      }
    </ol>
  </Window>

  <Window title="Docs · learning roadmap" id="roadmap" bodyClass="pad">
    <p class="lede">
      My own 31-module curriculum. The order is the plan, not completion dates. First up: running the{' '}
      <a href="/work/ci-cd">v2 pipeline template</a> end to end here, on a golden workload with a private registry (P06)
      and a self-hosted CI runner (P11).
    </p>
    <p class="meta tally">{counts.partial ?? 0} partially built · {counts.planned ?? 0} planned</p>

    <details class="roadmap panel">
      <summary>Show the full roadmap <span class="meta">(31 modules)</span></summary>
      <div class="phases">
        {
          roadmap.map((p) => (
            <section class="phase" aria-label={`Phase ${p.phase}`}>
              <h3 class="kicker">{p.phase}</h3>
              <ul>
                {p.items.map((i) => (
                  <li class={`item item--${i.state}`}>
                    <span class="item-id mono">{i.id}</span>
                    <span class="item-name">{i.name}</span>
                    <span class={`status status--${i.state}`}>{stateLabel[i.state]}</span>
                    <span class="item-why">{i.why}</span>
                  </li>
                ))}
              </ul>
            </section>
          ))
        }
      </div>
      <p class="meta roadmap-note">
        Planned modules aren't claims. An item only moves up once there's a dated repo, screenshot or log to back it.
      </p>
    </details>
  </Window>
</Base>

<style>
  .now {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(17rem, 1fr));
    gap: var(--space-3);
    list-style: none;
  }

  .now h3 {
    margin-top: var(--space-1);
    font-size: var(--fs-md);
  }

  .now .panel-b p {
    margin-top: var(--space-1);
    color: var(--muted);
  }

  .now .panel-h .mono {
    text-transform: none;
    letter-spacing: 0;
  }

  .notes {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-3);
    list-style: none;
  }

  .notes .panel-h > span:first-child {
    color: var(--text);
    font-size: var(--fs);
    letter-spacing: 0;
    text-transform: none;
  }

  .notes dl div {
    display: grid;
    grid-template-columns: 6rem 1fr;
    gap: var(--space-3);
    padding-block: var(--space-2);
  }

  .notes dl div + div {
    border-top: 1px solid var(--border);
  }

  .notes dt {
    font: 500 var(--fs-xs) / 1.6 var(--mono);
    color: var(--muted);
  }

  .notes dd {
    color: var(--muted);
  }

  .tally {
    margin-top: var(--space-4);
  }

  .roadmap {
    margin-top: var(--space-3);
  }

  .roadmap summary {
    padding: var(--space-3) var(--space-4);
    font-weight: 600;
    cursor: pointer;
  }

  .phases {
    padding: 0 var(--space-4) var(--space-4);
  }

  .phase + .phase {
    margin-top: var(--space-5);
  }

  .phase h3 {
    padding-bottom: var(--space-2);
    border-bottom: 1px solid var(--border-strong);
  }

  .phase ul {
    list-style: none;
  }

  .item {
    display: grid;
    grid-template-columns: 3.5rem minmax(0, 1fr) 6.5rem;
    grid-template-areas:
      'id name status'
      '. why why';
    gap: 2px var(--space-3);
    padding-block: var(--space-2);
    border-bottom: 1px solid var(--border);
  }

  .item-id {
    grid-area: id;
    color: var(--muted);
    font-size: var(--fs-sm);
  }

  .item-name {
    grid-area: name;
    font-weight: 500;
  }

  .item .status {
    grid-area: status;
    justify-self: end;
  }

  .item-why {
    grid-area: why;
    font-size: var(--fs-sm);
    color: var(--muted);
  }

  .item--planned .item-name {
    font-weight: 400;
    color: var(--muted);
  }

  .roadmap-note {
    padding: var(--space-3) var(--space-4);
    border-top: 1px solid var(--border);
  }

  @media (max-width: 48rem) {
    .notes {
      grid-template-columns: 1fr;
    }
    .notes dl div {
      grid-template-columns: 1fr;
      gap: 0;
    }
    .item {
      grid-template-columns: 3.2rem minmax(0, 1fr);
      grid-template-areas:
        'id name'
        '. status'
        '. why';
    }
    .item .status {
      justify-self: start;
    }
  }
</style>
