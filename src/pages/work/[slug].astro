---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Window from '../../components/os/Window.astro';
import { person } from '../../data/profile';

export async function getStaticPaths() {
  const cases = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);
  return cases.map((entry, i) => ({
    params: { slug: entry.id },
    props: { entry, next: cases[(i + 1) % cases.length] },
  }));
}

interface Props {
  entry: CollectionEntry<'work'>;
  next: CollectionEntry<'work'>;
}

const { entry, next } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
const index = String(d.order).padStart(2, '0');
const seo = {
  'ci-cd': {
    title: 'CI/CD pipelines for production services',
    description: 'How Rafif Dzaky Daniswara moved 20+ production services to GitHub Actions pipelines with automated checks, release approvals and lessons from failures.',
  },
  monitoring: {
    title: 'Monitoring and incident response',
    description: 'How Rafif monitors production services with Prometheus, Grafana and Uptime Kuma, then investigates incidents across Linux hosts and Laravel workers.',
  },
  'pit-wall-on-call': {
    title: 'Pit Wall On-Call: a game run like production',
    description: 'How Rafif Dzaky Daniswara builds, tests and deploys Pit Wall On-Call, a browser game about on-call incidents, with SHA-tagged images, a Tailscale deploy path and automatic rollback proven in a game day.',
  },
  'linux-ops': {
    title: 'Linux and VPS operations',
    description: 'How Rafif provisions and operates Linode VPS infrastructure, including Linux, domains, TLS, access, backups, databases and service delivery.',
  },
} as Record<string, { title: string; description: string }>;
const pageSeo = seo[entry.id] ?? { title: d.kicker, description: d.summary };
---

<Base title={pageSeo.title} description={pageSeo.description} ogType="article" current="work">
  <Window title={`Docs · ~/work/${entry.id}`} as="p" id="top" bodyClass="page-top">
    <p class="meta crumbs"><a href="/#work">Work</a> <span aria-hidden="true">/</span> {index} · {d.kicker}</p>
    <h1>{d.title}</h1>
    <p class="lede">{d.summary}</p>

    <dl class="facts panel">
      <div><dt>Context</dt><dd>{d.context}</dd></div>
      <div><dt>Period</dt><dd>{d.period}</dd></div>
      <div class="wide"><dt>Role</dt><dd>{d.role}</dd></div>
      <div class="wide">
        <dt>Stack</dt>
        <dd>
          <ul class="stack">{d.stack.map((s) => <li>{s}</li>)}</ul>
        </dd>
      </div>
    </dl>
  </Window>

  <Window title="Case study" as="p" id="case" bodyClass="pad">
    <div class="grid">
      <article class="prose">
        <Content />
      </article>

      <aside class="glance panel" aria-label="At a glance">
        <p class="kicker">At a glance</p>
        <dl>
          {
            d.glance.map((g) => (
              <div>
                <dt>{g.k}</dt>
                <dd>{g.v}</dd>
              </div>
            ))
          }
        </dl>
        <p class="glance-cta">
          Questions about this work?<br />
          <a href={`mailto:${person.email}`}>{person.email}</a>
        </p>
      </aside>
    </div>
  </Window>

  <nav class="next window" aria-label="Next case study">
    <a class="next-link" href={`/work/${next.id}`}>
      <span class="meta">Next case · {String(next.data.order).padStart(2, '0')} · {next.data.kicker}</span>
      <span class="next-title">{next.data.title} →</span>
    </a>
  </nav>
</Base>

<style>
  .crumbs a {
    color: var(--accent-text);
  }

  .facts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr));
    gap: var(--s-4) var(--s-6);
    width: 100%;
    max-width: 60rem;
    margin-top: var(--s-2);
    padding: var(--s-4) var(--s-5);
  }

  .facts .wide {
    grid-column: 1 / -1;
  }

  .facts dt {
    font: 500 0.72rem / 1.4 var(--font-mono);
    letter-spacing: 0.01em;
    text-transform: none;
    color: var(--muted);
  }

  .facts dd {
    margin-top: var(--s-1);
  }

  .stack {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2);
    list-style: none;
  }

  .stack li {
    padding: 1px 8px;
    border-radius: var(--radius-sm);
    background: var(--sunken);
    font: 400 var(--fs-sm) / 1.6 var(--mono);
  }

  .grid {
    display: grid;
    grid-template-columns: minmax(0, var(--measure)) 17rem;
    justify-content: space-between;
    gap: var(--s-7);
    align-items: start;
  }

  .prose > :global(h2:first-child) {
    margin-top: 0;
  }

  .glance {
    position: sticky;
    top: calc(var(--topbar-h) + 20px);
    padding: var(--s-4);
  }

  .glance dl {
    margin-top: var(--s-3);
  }

  .glance dl div + div {
    margin-top: var(--s-4);
  }

  .glance dt {
    font-weight: 600;
  }

  .glance dd {
    margin-top: var(--s-1);
    line-height: 1.5;
    color: var(--muted);
  }

  .glance-cta {
    margin-top: var(--s-5);
    padding-top: var(--s-4);
    border-top: var(--hair) dashed var(--border-strong);
    font-size: 0.9rem;
    color: var(--muted);
    overflow-wrap: anywhere;
  }

  .glance-cta a {
    color: var(--accent-text);
  }

  .next {
    display: block;
  }

  .next-link {
    display: grid;
    gap: var(--s-2);
    padding: var(--s-4) var(--s-5);
    border-radius: var(--radius-window);
    text-decoration: none;
  }

  .next-link:hover .next-title {
    color: var(--accent-text);
  }

  .next-title {
    font-size: var(--fs-lg);
    font-weight: 600;
    line-height: var(--leading-snug);
  }

  @media (max-width: 60rem) {
    .grid {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--s-5);
    }
    .glance {
      position: static;
      order: -1;
    }
    .glance dl {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr));
      gap: var(--s-4);
    }
    .glance dl div + div {
      margin-top: 0;
    }
    .glance-cta {
      display: none;
    }
  }
</style>
