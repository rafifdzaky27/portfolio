        <div class="setting-row"><span class="k">LinkedIn</span><a class="v" href={person.linkedin} rel="me noopener">in/rafifdzaky</a><span></span></div>
        <div class="setting-row"><span class="k">GitHub</span><a class="v" href={person.github} rel="me noopener">rafifdzaky27</a><span></span></div>
      </div>
      <div class="actions">
        <a class="btn primary" href={person.resumePdf} download={person.resumeFile}><svg width="16" height="16" aria-hidden="true"><use href="#g-dl"></use></svg>Download CV</a>
