---
import Base from '../layouts/Base.astro';
import { Image } from 'astro:assets';
import { pitwall } from '../data/pitwall';
import BoardingPass from '../components/BoardingPass.astro';
import ReleaseRoute from '../components/ReleaseRoute.astro';
import HomelabMap from '../components/HomelabMap.astro';
import SectionHead from '../components/SectionHead.astro';
import Credentials from '../components/Credentials.astro';
import OffTheClock from '../components/OffTheClock.astro';
import FinOps from '../components/FinOps.astro';
import { postmortems, adrs } from '../data/ops';
import {
  person,
  experience,
  skills,
  education,
  responsibilities,
  careerStart,
  devopsStart,
  monthsSince,
  formatDuration,
} from '../data/profile';
import { notes } from '../data/homelab';

const contextLabel = {
  professional: 'Full-time',
  freelance: 'Freelance',
  internship: 'Internship',
  teaching: 'Teaching',
} as const;

const totalExp = formatDuration(monthsSince(careerStart));
const devopsExp = formatDuration(monthsSince(devopsStart));

const cases = [
  {
    no: '01',
    href: '/work/ci-cd',
    kicker: 'CI/CD modernization',
    from: 'ssh + git pull',
    to: 'gated pipelines',
    title: 'Moving 20+ services to GitHub Actions',
    text: 'All 20+ production services release through GitHub Actions. About 60% deploy fully automatically; production releases are dispatched and confirmed by me, through the same pipeline.',
    chips: ['~60% auto-deploy', '<2% failed prod runs', '16 failure → fix notes'],
  },
  {
    no: '02',
    href: '/work/monitoring',
    kicker: 'Monitoring & incidents',
    from: 'user reports',
    to: 'alerts and dashboards',
    title: 'Monitoring and incident response',
    text: 'Prometheus, Grafana and Uptime Kuma across the VPS fleet: CPU, memory, disk, availability, and the incident routine for Laravel apps and their queue workers.',
    chips: ['Prometheus', 'Grafana', 'Uptime Kuma', 'on-call'],
  },
  {
    no: '03',
    href: '/work/linux-ops',
    kicker: 'Infra operations',
    from: 'bare VPS',
    to: 'running service',
    title: 'Running the Linode VPS fleet',
    text: 'Provisioning and scaling Linode VPS, domains and DNS, SSL, web server config, IAM and SSH access, hardening, secrets, databases and backups.',
    chips: ['domains & SSL', 'IAM', 'hardening', 'backups'],
  },
];

const profileSchema = {
  '@context': 'https://schema.org',
  '@type': 'ProfilePage',
  '@id': 'https://rafifdzaky.com/#profile',
  url: 'https://rafifdzaky.com/',
  mainEntity: {
    '@type': 'Person',
    '@id': 'https://rafifdzaky.com/#person',
    name: person.name,
    url: 'https://rafifdzaky.com/',
    jobTitle: person.role,
    homeLocation: { '@type': 'Place', name: person.location },
    alumniOf: { '@type': 'CollegeOrUniversity', name: education.school },
    sameAs: [person.github, person.linkedin],
    knowsAbout: [
      'DevOps', 'CI/CD', 'Linux', 'Docker', 'GitHub Actions',
      'Prometheus', 'Grafana', 'cloud infrastructure', 'SRE practices',
      'platform engineering',
    ],
  },
};
---

<Base structuredData={profileSchema}>
  <!-- ============ HERO ============ -->
  <section class="hero wrap" aria-labelledby="hero-title">
    <div class="hero-top">
      <p class="kicker">Jakarta · open to DevOps roles</p>
      <button type="button" class="exec-btn" data-exec-open>
        <span aria-hidden="true">⏱</span> One-minute summary
      </button>
    </div>
    <h1 id="hero-title">{person.name} <span>DevOps Engineer</span></h1>
    <BoardingPass />
  </section>

  <!-- ============ ABOUT ============ -->
  <section class="section band" id="about" aria-labelledby="about-title">
    <div class="wrap">
      <SectionHead index="01" label="About" title="What I do" id="about-title" />

      <div class="about">
        <div class="about-copy">
          <p>
            I'm a DevOps Engineer at {person.employer} in Jakarta. I look after everything that happens after a pull
            request is merged, for 20+ production services: the pipelines that ship them, the servers they land on, and
            the monitoring that tells me when something drifts.
          </p>
          <p>
            Day to day that means provisioning and scaling Linode VPS, running domains, DNS and SSL certificates,
            managing access and IAM, hardening servers, keeping secrets out of repos, looking after databases and
            backups, and being the one who picks up when production goes red.
          </p>
          <p>
            Before DevOps I built the applications themselves in React, Node.js and Laravel, including backend
            microservices at bank bjb and a Laravel module taught to 400+ students at Telkom University. So when
            something breaks, I can read it from the app side as well as the server side.
          </p>

          <dl class="years">
            <div><dt>Experience</dt><dd data-exp="total">{totalExp}</dd><dd class="sub">since Jan 2025</dd></div>
            <div><dt>In DevOps</dt><dd data-exp="devops">{devopsExp}</dd><dd class="sub">since Jan 2026</dd></div>
            <div><dt>Services</dt><dd>20+</dd><dd class="sub">in production</dd></div>
          </dl>
        </div>

        <div class="job ticket">
          <p class="kicker">What the job covers</p>
          <dl>
            {
              responsibilities.map((r) => (
                <div>
                  <dt>{r.area}</dt>
                  <dd>
                    {r.items.map((i) => (
                      <span>{i}</span>
                    ))}
                  </dd>
                </div>
              ))
            }
          </dl>
        </div>
      </div>

      <div class="about-foot">
        <div class="edu ticket">
          <p class="kicker">Education</p>
          <p class="edu-degree">{education.degree}</p>
          <p>{education.school} · {education.faculty}</p>
          <p class="edu-gpa">GPA {education.gpa} · <strong>{education.honours}</strong></p>
          <p class="meta">{education.years} · {education.status}</p>
          <div class="stamp edu-stamp" aria-hidden="true"><span>Telkom Univ.<strong>S.Kom</strong>GPA 3.87<br />Cum laude</span></div>
        </div>
        <div class="creds-wrap ticket">
          <p class="kicker">Credentials</p>
          <Credentials />
        </div>
        <div class="lang ticket">
          <p class="kicker">Languages</p>
          <p><strong>Indonesian</strong><br /><span class="meta">native</span></p>
          <p><strong>English</strong><br /><span class="meta">professional working</span></p>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ WORK ============ -->
  <section class="section wrap" id="work" aria-labelledby="work-title">
    <SectionHead index="02" label="Work" title="Work and projects" id="work-title">
      <p class="lede">
        Every production service goes through the same GitHub Actions pipeline. About 60% deploy on their own, and I
        approve the production run for the rest.
      </p>
    </SectionHead>

    <div class="route-wrap"><ReleaseRoute /></div>

    <ul class="cases">
      {
        cases.map((c) => (
          <li class="case ticket">
            <a class="case-link" href={c.href}>
              <p class="case-top">
                <span class="meta">
                  {c.no} · {c.kicker}
                </span>
                <span class="meta">Professional</span>
              </p>
              <p class="case-route" aria-hidden="true">
                <span>{c.from}</span>
                <span class="case-arrow" />
                <span>{c.to}</span>
              </p>
              <h3>{c.title}</h3>
              <p class="case-text">{c.text}</p>
              <ul class="chips">
                {c.chips.map((ch) => (
                  <li>{ch}</li>
                ))}
              </ul>
              <span class="arrow-link">Read the case study</span>
            </a>
          </li>
        ))
      }
    </ul>

    <article class="feature ticket" aria-labelledby="pw-title">
      <a class="feature-shot" href="/work/pit-wall-on-call" tabindex="-1" aria-hidden="true">
        <Image src={pitwall.cafe} alt="" widths={[640, 960, 1280]} sizes="(min-width: 56rem) 40rem, 100vw" />
      </a>
      <div class="feature-body">
        <p class="case-top">
          <span class="meta">04 · Pit Wall On-Call</span>
          <span class="status status--live">Live</span>
        </p>
        <h3 id="pw-title">A game about being on call, running in production</h3>
        <p class="case-text">
          You take the page, find the cause and protect the error budget. Every merge runs 700+ tests,
          ships SHA-tagged images to GHCR and deploys to my homelab over Tailscale. A bad release rolls
          itself back, and I proved it by breaking production on purpose.
        </p>
        <ul class="chips">
          <li>TypeScript + Postgres</li>
          <li>GHCR + Tailscale</li>
          <li>auto rollback, drilled</li>
        </ul>
        <p class="feature-links">
          <a class="arrow-link" href="/work/pit-wall-on-call">Read the case study</a>
          <a class="arrow-link" href="https://pitwall.rafifdzaky.com">Play it</a>
        </p>
      </div>
    </article>
  </section>

  <!-- ============ EXPERIENCE ============ -->
  <section class="section band" id="experience" aria-labelledby="exp-title">
    <div class="wrap">
      <SectionHead index="03" label="Experience" title="Where I've worked" id="exp-title">
        <p class="lede">{totalExp} of professional experience, newest first.</p>
      </SectionHead>

      <ol class="itinerary">
        {
          experience.map((r) => (
            <li class={`leg leg--${r.context}`}>
              <p class="leg-when">{r.period}</p>
              <div class="leg-body">
                <h3>{r.title}</h3>
                <p class="leg-org">
                  {r.org} · {r.place} <span class="tag">{contextLabel[r.context]}</span>
                </p>
                <ul>
                  {r.points.map((p) => (
                    <li>{p}</li>
                  ))}
                </ul>
                {r.link && (
                  <a class="arrow-link" href={r.link.href}>
                    {r.link.label}
                  </a>
                )}
              </div>
            </li>
          ))
        }
      </ol>

      <div class="resume-row">
        <p>The one-page résumé:</p>
        <a class="btn btn--primary" href={person.resumePage}>View resume</a>
        <a class="btn" href={person.resumePdf} download={person.resumeFile}>Download</a>
      </div>

      <h3 class="toolkit-h">Toolkit, by where I've used it</h3>
      <div class="skills">
        {
          [skills.work, skills.lab, skills.learning].map((col, i) => (
            <section class={`skill-col skill-col--${i}`} aria-label={col.label}>
              <h4>{col.label}</h4>
              <p class="meta">{col.note}</p>
              <dl>
                {col.groups.map((g) => (
                  <div>
                    <dt>{g.area}</dt>
                    <dd>{g.items.join(' · ')}</dd>
                  </div>
                ))}
              </dl>
            </section>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ============ HOMELAB ============ -->
  <section class="section wrap" id="homelab" aria-labelledby="lab-title">
    <SectionHead index="04" label="Homelab" title="My homelab" id="lab-title">
      <p class="lede">
        One Proxmox host at home, where I learn the things I don't run at work yet. Each piece below is marked running,
        partial or planned.
      </p>
    </SectionHead>
    <p class="served">
      <span class="served-tag">Note</span> This site runs on this homelab, behind a Cloudflare Tunnel.
    </p>
    <div class="map-wrap"><HomelabMap /></div>

    <div class="lab-notes">
      <p class="kicker">Latest troubleshooting notes</p>
      <ul>
        {
          notes.map((n) => (
            <li>
              <span class="meta">{n.state === 'resolved' ? '✓ resolved' : '… investigating'}</span>
              <span>{n.title}</span>
            </li>
          ))
        }
      </ul>
      <a class="arrow-link" href="/homelab">Notes, statuses and the full 31-module roadmap</a>
    </div>
  </section>

  <!-- ============ RESEARCH ============ -->
  <section class="section band" id="research" aria-labelledby="research-title">
    <div class="wrap">
      <SectionHead index="05" label="Research" title="What makes small businesses adopt a POS app?" id="research-title" />
      <div class="research ticket">
        <div class="research-main">
          <p class="award"><span aria-hidden="true">◆</span> Best Presenter · ICICoS 2026</p>
          <h3>Explaining Digital POS Adoption Among MSMEs: A Pilot Study Using UTAUT2</h3>
          <p class="meta">Daniswara, Saputra & Panduwiyasa · Telkom University · presented Aug 2026 · not yet published</p>
          <p>
            A PLS-SEM pilot with 50 MSME practitioners in Bandung Raya. I refined a 37-item UTAUT2 questionnaire down to
            33 reliable items. Social influence, enjoyment and price value showed the largest effects on intention to
            use a POS app.
          </p>
          <a class="arrow-link" href="/research">Method, results and limits</a>
        </div>
        <dl class="research-nums">
          <div><dt>respondents</dt><dd>50</dd></div>
          <div><dt>items kept</dt><dd>33 / 37</dd></div>
          <div><dt>R² intention</dt><dd>0.844</dd></div>
          <div><dt>R² use</dt><dd>0.548</dd></div>
        </dl>
      </div>
    </div>
  </section>

  <!-- ============ OPERATING MANUAL ============ -->
  <section class="section" id="ops" aria-labelledby="ops-title">
    <div class="wrap">
      <SectionHead index="06" label="Notes" title="Postmortems and decisions" id="ops-title">
        <p class="lede">
          Write-ups from building and running this site: what broke, what I changed, and why I chose what I chose.
        </p>
      </SectionHead>
      <ul class="manual">
        <li>
          <a class="man ticket" href="/postmortems">
            <span class="man-n">{postmortems.length}</span>
            <span class="man-t">Postmortems</span>
            <span class="man-d">Incidents from building this site, and what I changed after each one.</span>
          </a>
        </li>
        <li>
          <a class="man ticket" href="/decisions">
            <span class="man-n">{adrs.length}</span>
            <span class="man-t">Architecture decisions</span>
            <span class="man-d">The choices behind this site and their trade-offs.</span>
          </a>
        </li>
        <li>
          <a class="man ticket" href="/status" data-live-status>
            <span class="man-n" data-live-up>live</span>
            <span class="man-t">Status</span>
            <span class="man-d" data-live-d>This site, checked from outside the homelab by a scheduled GitHub Action.</span>
          </a>
        </li>
      </ul>
      <FinOps />
    </div>
  </section>

  <!-- ============ OFF THE CLOCK ============ -->
  <section class="section band" id="off-the-clock" aria-labelledby="otc-title">
    <div class="wrap">
    <SectionHead index="07" label="Off the clock" title="Outside work" id="otc-title">
      <p class="lede">
        Formula 1, Liverpool and tennis. The board is styled like an F1 timing screen: pick a row to switch.
      </p>
      <p class="otc-fineprint">Lap times, tyres and radio lines are made up for fun.</p>
    </SectionHead>
    <OffTheClock />
    </div>
  </section>

  <!-- ============ CONTACT ============ -->
  <section class="section contact" id="contact" aria-labelledby="contact-title">
    <div class="wrap">
      <SectionHead index="08" label="Contact" title="Get in touch" id="contact-title" />
      <div class="contact-card ticket">
        <div>
          <p class="lbl">Email</p>
          <a class="contact-big" href={`mailto:${person.email}`}>{person.email}</a>
        </div>
        <div>
          <p class="lbl">Phone</p>
          <a class="contact-mid" href={person.phoneHref}>{person.phone}</a>
        </div>
        <ul class="contact-links">
          <li><a class="btn" href={person.linkedin} target="_blank" rel="me noopener">LinkedIn ↗</a></li>
          <li><a class="btn" href={person.github} target="_blank" rel="me noopener">GitHub ↗</a></li>
          <li><a class="btn btn--primary" href={person.resumePage}>View resume</a></li>
        </ul>
        <p class="meta">Based in {person.location} · Indonesian and English</p>
      </div>
    </div>
  </section>
</Base>

<script>
  import { careerStart, devopsStart, monthsSince, formatDuration } from '../data/time';
  const set = (sel: string, v: string) => document.querySelectorAll(sel).forEach((el) => (el.textContent = v));
  set('[data-exp="total"]', formatDuration(monthsSince(careerStart)));
  set('[data-exp="devops"]', formatDuration(monthsSince(devopsStart)));

  // The Status card shows the real uptime once it scrolls into view.
  import { ago } from '../scripts/trace';
  const live = document.querySelector<HTMLElement>('[data-live-status]');
  if (live && 'IntersectionObserver' in window) {
    const io = new IntersectionObserver(async (entries) => {
      if (!entries.some((e) => e.isIntersecting)) return;
      io.disconnect();
      try {
        const res = await fetch('https://raw.githubusercontent.com/rafifdzaky27/portfolio/status/uptime.json', { cache: 'no-store' });
        const data = await res.json();
        const site = data.components?.site;
        if (!site) return;
        const days = Object.values(site.days) as { n: number; up: number }[];
        const n = days.reduce((a, d) => a + d.n, 0);
        const up = days.reduce((a, d) => a + d.up, 0);
        if (!n) return;
        const p = (100 * up) / n;
        const last = site.recent[site.recent.length - 1];
        live.querySelector('[data-live-up]')!.textContent = `${p >= 99.995 ? '100' : p.toFixed(2)}%`;
        live.querySelector('[data-live-d]')!.textContent =
          `${last?.ok ? '● operational' : '▲ failing'} · ${n} outside checks · last ${ago(data.updated)}`;
      } catch {
        /* keep the static text */
      }
    });
    io.observe(live);
  }
</script>

<style>
  .otc-fineprint {
    margin-top: var(--s-2);
    font: 400 0.78rem / 1.4 var(--font-mono);
    color: var(--muted);
  }

  /* ---------- hero ---------- */
  .hero-top {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-2) var(--s-4);
  }

  .exec-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.4rem 0.8rem;
    border: var(--rule) solid var(--ink);
    border-radius: var(--radius);
    background: var(--card);
    color: var(--ink);
    font: 500 0.8rem / 1 var(--font-mono);
    cursor: pointer;
  }

  .exec-btn:hover {
    background: var(--ink);
    color: var(--paper);
  }

  .exec-s {
    padding: 0.1rem 0.35rem;
    border-radius: var(--radius);
    background: var(--accent-soft);
    color: var(--accent-deep);
    font-size: 0.7rem;
  }

  :global(html:not(.js)) .exec-btn {
    display: none;
  }

  /* ---------- operating manual ---------- */
  .manual {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--s-4);
    margin-top: var(--s-6);
    list-style: none;
  }

  .man {
    display: grid;
    align-content: start;
    gap: var(--s-2);
    height: 100%;
    padding: var(--s-5);
    text-decoration: none;
    transition:
      transform var(--dur-fast) var(--ease),
      box-shadow var(--dur-fast) var(--ease);
  }

  .man:hover {
    transform: translate(-2px, -2px);
    box-shadow: 4px 4px 0 var(--ink);
  }

  .man-n {
    font: 600 var(--step-3) / 1 var(--font-sans);
    letter-spacing: -0.03em;
    color: var(--accent-deep);
  }

  .man-t {
    font-weight: 650;
    font-size: var(--step-1);
  }

  .man-t::after {
    content: '→';
    margin-left: 0.3em;
    color: var(--accent);
  }

  .man-d {
    color: var(--muted);
    font-size: 0.95rem;
  }

  @media (max-width: 64rem) {
    .manual {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 36rem) {
    .manual {
      grid-template-columns: 1fr;
    }
  }
  .hero {
    padding-block: var(--s-7) var(--s-7);
  }

  .hero h1 {
    margin: var(--s-3) 0 var(--s-6);
    font-size: var(--step-4);
    letter-spacing: -0.035em;
    max-width: none;
  }

  .hero h1 span {
    color: var(--muted);
    font-weight: 500;
  }

  /* one row, no scrollbar. Phones can swipe it; the edge fades instead of showing a bar */
  .facts {
    display: flex;
    flex-wrap: nowrap;
    justify-content: flex-start;
    gap: var(--s-3);
    margin-top: var(--s-6);
    list-style: none;
    overflow-x: auto;
    scrollbar-width: none;
    scroll-snap-type: x proximity;
  }

  .facts::-webkit-scrollbar {
    display: none;
  }

  @media (max-width: 64rem) {
    .facts {
      mask-image: linear-gradient(90deg, #000 85%, transparent);
    }
  }

  .facts li {
    flex: none;
    white-space: nowrap;
    scroll-snap-align: start;
    padding: 0.38rem 0.75rem;
    border: var(--rule) solid var(--ink);
    border-radius: var(--radius);
    background: var(--card);
    font: 400 0.8rem / 1.3 var(--font-mono);
  }

  .facts .k {
    color: var(--muted);
  }

  .facts a {
    color: inherit;
    text-decoration: none;
  }

  .facts li:has(a):hover {
    background: var(--ink);
    color: var(--paper);
  }

  .facts li:has(a):hover .k {
    color: inherit;
  }

  .facts .k::after {
    content: ':';
  }

  /* ---------- about ---------- */
  .about {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    gap: var(--s-7);
    margin-top: var(--s-6);
    align-items: start;
  }

  .about-copy {
    display: grid;
    gap: var(--s-4);
    font-size: var(--step-1);
    line-height: 1.55;
    color: var(--muted);
  }

  .about-copy p:first-child {
    color: var(--ink);
  }

  .years {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--s-4);
    margin-top: var(--s-4);
    padding-top: var(--s-4);
    border-top: var(--rule) solid var(--ink);
  }

  .years dt {
    font: 500 0.72rem / 1.4 var(--font-mono);
    letter-spacing: 0.01em;
    text-transform: none;
    color: var(--muted);
  }

  .years dd {
    font-size: var(--step-2);
    font-weight: 650;
    letter-spacing: -0.02em;
    color: var(--ink);
    line-height: 1.2;
  }

  .years dd.sub {
    font: 400 0.8rem / 1.4 var(--font-mono);
    letter-spacing: 0;
    color: var(--muted);
  }

  .job {
    padding: var(--s-5);
  }

  .job dl {
    display: grid;
    gap: var(--s-3);
    margin-top: var(--s-3);
  }

  .job dl div {
    display: grid;
    grid-template-columns: 8.5rem minmax(0, 1fr);
    gap: var(--s-3);
    padding-top: var(--s-3);
    border-top: var(--hair) solid var(--line);
  }

  .job dt {
    font-weight: 600;
    font-size: 0.95rem;
  }

  .job dd {
    display: flex;
    flex-wrap: wrap;
