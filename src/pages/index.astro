---
import Base from '../layouts/Base.astro';
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import Window from '../components/os/Window.astro';
import portrait from '../assets/rafif.png';
import { pitwall } from '../data/pitwall';
import { postmortems, adrs } from '../data/ops';
import {
  person,
  experience,
  education,
  credentials,
  careerStart,
  devopsStart,
  monthsSince,
  formatDuration,
} from '../data/profile';

const totalExp = formatDuration(monthsSince(careerStart));
const devopsExp = formatDuration(monthsSince(devopsStart));

const kind = {
  professional: 'Full-time',
  freelance: 'Freelance',
  internship: 'Internship',
  teaching: 'Part-time',
} as const;

// Case studies, in the order set in each file's front matter.
const blurb: Record<string, string> = {
  'ci-cd': 'From SSH and git pull to GitHub Actions. About 60% deploy on merge, the rest wait for my approval, and under 2% of production runs failed.',
  monitoring: 'Prometheus, Grafana and Uptime Kuma for the VPS fleet, and my routine when something breaks.',
  'linux-ops': 'The Linode fleet: DNS, SSL, IAM, hardening, secrets, backups and databases, with written deployment SOPs.',
  'pit-wall-on-call': 'My on-call game, shipped by its own pipeline with smoke tests and an automatic rollback.',
};
const cases = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);

const years = (period: string) => period.replace(/^.*?(\d{4}).*$/, '$1');

// Each row opens a detail view. Text comes from the CV (src/data/profile.ts).
interface FileRow {
  k: 'work' | 'edu' | 'cert';
  icon: string;
  name: string;
  sub: string;
  kind: string;
  date: string;
  points?: string[];
  lines?: string[];
  link?: { href: string; label: string };
  image?: ImageMetadata;
  alt?: string;
}
const files: FileRow[] = [
  ...experience.map((r) => ({
    k: 'work' as const,
    points: r.points,
    link: r.link,
    icon: 'f-folder',
    name: r.title.replace(/ \(Freelance\)$/, ''),
    sub: `${r.org}${r.place ? `, ${r.place}` : ''}`,
    kind: kind[r.context],
    date: r.period,
  })),
  {
    k: 'edu',
    icon: 'f-doc',
    lines: [
      `${education.degree}, ${education.school}`,
      `${education.faculty}, Bandung · ${education.years}`,
      `GPA ${education.gpa} · ${education.honours}`,
      `${education.status}.`,
    ],
    name: 'S.Kom, Information Systems',
    sub: `${education.school} · GPA ${education.gpa.split(' ')[0]}, ${education.honours.toLowerCase()}`,
    kind: 'Degree',
    date: education.years.split('–').pop()!.trim(),
  },
  ...credentials.map((c) => ({
    k: 'cert' as const,
    lines: [c.detail],
    link: c.link,
    image: c.image,
    alt: c.alt,
    icon: c.name.startsWith('Best Presenter') || c.name.startsWith('NetAcad') ? 'f-award' : 'f-doc',
    name: c.name.replace(/ — /g, ', '),
    sub: c.issuer,
    kind: c.name.startsWith('Best Presenter') || c.name.startsWith('NetAcad') ? 'Award' : 'Certificate',
    date: c.period.split('–')[0].trim() || years(c.period),
  })),
];
const count = (k: string) => files.filter((f) => f.k === k).length;

const profileSchema = {
  '@context': 'https://schema.org',
  '@type': 'ProfilePage',
  '@id': 'https://rafifdzaky.com/#profile',
  url: 'https://rafifdzaky.com/',
  mainEntity: {
    '@type': 'Person',
    '@id': 'https://rafifdzaky.com/#person',
    name: person.name,
    url: 'https://rafifdzaky.com/',
    jobTitle: person.role,
    homeLocation: { '@type': 'Place', name: person.location },
    alumniOf: { '@type': 'CollegeOrUniversity', name: education.school },
    sameAs: [person.github, person.linkedin],
    knowsAbout: [
      'DevOps', 'CI/CD', 'Linux', 'Docker', 'GitHub Actions',
      'Prometheus', 'Grafana', 'cloud infrastructure', 'SRE practices',
      'platform engineering',
    ],
  },
};
---

<Base structuredData={profileSchema} deskClass="home">
  <!-- ============ ABOUT ============ -->
  <Window title="About · rafif" id="about" class="w-full" focused>
    <div class="about">
      <div class="about-pic">
        <Image
          src={portrait}
          alt={`Portrait of ${person.name}, arms crossed, in a dark shirt`}
          widths={[240, 360, 600]}
          sizes="(max-width: 640px) 120px, (max-width: 860px) 150px, 300px"
          loading="eager"
          fetchpriority="high"
        />
      </div>
      <div class="about-head">
        <p class="about-tags"><span class="tag ok">Open to DevOps roles</span><span class="tag info">Jakarta · WIB</span></p>
        <h1>{person.name}</h1>
        <p class="role"><b>{person.role}</b> at {person.employer} · since Jan 2026</p>
      </div>
      <div class="about-body">
        <p class="about-lede">
          I moved every production service at PT PSM, 20+ of them, from SSH and <span class="mono">git pull</span> to
          GitHub Actions. I also run the Linode VPS fleet, DNS, SSL, IAM, secrets, backups, databases and monitoring,
          and I wrote the deployment SOPs our developers release with.
        </p>
        <div class="actions">
          <a class="btn primary btn-lg" href={person.resumePdf} download={person.resumeFile}>
            <svg width="16" height="16" aria-hidden="true"><use href="#g-dl"></use></svg>Download CV
          </a>
          <a class="btn btn-lg" href={`mailto:${person.email}`}>
            <svg width="16" height="16" aria-hidden="true"><use href="#g-mail"></use></svg>Email me
          </a>
          <button class="btn btn-lg" type="button" data-exec-open>One-minute summary</button>
        </div>
        <div class="stats">
          <div class="panel stat">
            <div class="panel-h"><h2>Pipelines</h2><span class="tag ok">OK</span></div>
            <div class="panel-b">
              <p class="metric">20+<small>services</small></p>
              <div class="meter" aria-hidden="true"><i class="ok" style="width:100%"></i></div>
              <p class="metric-foot">All production services on GitHub Actions</p>
            </div>
          </div>
          <div class="panel stat">
            <div class="panel-h"><h2>Failed prod runs</h2><span class="tag ok">OK</span></div>
            <div class="panel-b">
              <p class="metric ok">&lt;2<small>%</small></p>
              <div class="meter" aria-hidden="true"><i class="ok" style="width:2%"></i><u style="left:10%"></u></div>
              <p class="metric-foot">Production deploy runs, core services</p>
            </div>
          </div>
          <div class="panel stat">
            <div class="panel-h"><h2>Auto deploy</h2><span class="tag info">Gated</span></div>
            <div class="panel-b">
              <p class="metric">~60<small>%</small></p>
              <div class="meter" aria-hidden="true"><i style="width:60%"></i></div>
              <p class="metric-foot">I approve production runs for the rest</p>
            </div>
          </div>
        </div>
        <p class="exp-line meta">
          <span data-exp="total">{totalExp}</span> of work since Jan 2025 · <span data-exp="devops">{devopsExp}</span> in DevOps
        </p>
      </div>
    </div>
  </Window>

  <!-- ============ WORK ============ -->
  <Window title="Monitoring · release pipeline" id="work" class="w-full">
    <div class="mon-grid">
      <div class="panel full">
        <div class="panel-h wrap">
          <h3>Release pipeline · every production service</h3>
          <ul class="map-legend">
            <li><span class="legend-dot ok"></span><b class="ok">Auto</b> deploys on merge</li>
            <li><span class="legend-dot warn"></span><b class="warn">Gate</b> I approve prod</li>
          </ul>
        </div>
        <div class="svc-map" data-edges="commit>build,build>test,test>package,package>auto:auto,package>gate:gate,auto>deploy:auto,gate>deploy:gate,deploy>verify">
          <svg class="svc-edges" aria-hidden="true"></svg>
          <ol class="svc-nodes pipe" aria-label="Release pipeline">
            <li class="svc-node" data-id="commit"><span class="tag info svc-key">1</span><span class="svc-name">commit</span><span class="svc-sub"><span class="svc-health ok">OK</span><span class="svc-detail">merge to release</span></span></li>
            <li class="svc-node" data-id="build"><span class="tag info svc-key">2</span><span class="svc-name">build</span><span class="svc-sub"><span class="svc-health ok">OK</span><span class="svc-detail">GitHub Actions</span></span></li>
            <li class="svc-node" data-id="test"><span class="tag info svc-key">3</span><span class="svc-name">test</span><span class="svc-sub"><span class="svc-health ok">OK</span><span class="svc-detail">CI checks</span></span></li>
            <li class="svc-node" data-id="package"><span class="tag info svc-key">4</span><span class="svc-name">package</span><span class="svc-sub"><span class="svc-health ok">OK</span><span class="svc-detail">one artifact</span></span></li>
            <li class="svc-node" data-id="auto"><span class="svc-name">auto deploy</span><span class="svc-sub"><span class="svc-health ok">~60%</span><span class="svc-detail">of services</span></span></li>
            <li class="svc-node" data-id="gate"><span class="svc-name">approval</span><span class="svc-sub"><span class="svc-health warn">Gate</span><span class="svc-detail">prod, by me</span></span></li>
            <li class="svc-node selected" data-id="deploy"><span class="tag info svc-key">5</span><span class="svc-name">deploy</span><span class="svc-sub"><span class="svc-health ok">OK</span><span class="svc-detail">production</span></span></li>
            <li class="svc-node" data-id="verify"><span class="tag info svc-key">6</span><span class="svc-name">verify</span><span class="svc-sub"><span class="svc-health ok">OK</span><span class="svc-detail">health check</span></span></li>
          </ol>
        </div>
      </div>

      <div class="panel span2">
        <div class="panel-h"><h3>Case studies</h3><span class="tag ok">{cases.length} resolved</span></div>
        <div class="panel-b">
          {
            cases.map((c) => (
              <a class="alert" href={`/work/${c.id}`}>
                <span class="alert-h"><span class="tag ok">OK</span><b>{c.data.kicker}</b></span>
                <span class="alert-path">/work/{c.id}</span>
                <span class="alert-d">{blurb[c.id] ?? c.data.summary}</span>
              </a>
            ))
          }
        </div>
      </div>

      <div class="panel side">
        <div class="panel-h"><h3>What I run</h3><span class="tag info">Linode</span></div>
        <div class="panel-b">
          <ul class="runs">
            <li><span class="k">Hosts</span><span>VPS fleet, DNS, SSL</span></li>
            <li><span class="k">Access</span><span>IAM, hardening, secrets</span></li>
            <li><span class="k">Data</span><span>Databases and backups</span></li>
            <li><span class="k">Observe</span><span>Prometheus, Grafana, Uptime Kuma</span></li>
            <li><span class="k">Process</span><span>Deployment SOPs</span></li>
          </ul>
        </div>
      </div>
    </div>
  </Window>

  <!-- ============ PIT WALL ============ -->
  <Window title="Browser · Pit Wall On-Call" id="pitwall" class="w-full">
    <div class="browser-tabs" aria-hidden="true">
      <span class="browser-tab"><svg class="app-icon" width="14" height="14" style="--app-color:var(--accent)"><use href="#i-monitoring"></use></svg>Pit Wall On-Call</span>
      <span class="browser-tab off">rafifdzaky27/pit-wall-on-call</span>
    </div>
    <div class="browser-toolbar">
      <span class="tool-btn dim" aria-hidden="true"><svg width="16" height="16"><use href="#g-back"></use></svg></span>
      <span class="tool-btn dim hide-sm" aria-hidden="true"><svg width="16" height="16"><use href="#g-fwd"></use></svg></span>
      <span class="tool-btn" aria-hidden="true"><svg width="16" height="16"><use href="#g-reload"></use></svg></span>
      <a class="omnibox" href="https://pitwall.rafifdzaky.com"><svg width="14" height="14" aria-hidden="true"><use href="#g-lock"></use></svg><span class="host">pitwall.rafifdzaky.com</span></a>
    </div>
    <div class="browser-page">
      <figure class="shot">
        <Image
          src={pitwall.cafe}
          alt="Pit Wall On-Call: the café in Jakarta where a shift starts, a laptop showing a 504 page and a phone with the page"
          widths={[640, 960, 1280]}
          sizes="(max-width: 860px) 100vw, 60vw"
        />
        <figcaption>Each shift starts in a café in Jakarta. The phone on the table has the page.</figcaption>
      </figure>
      <div class="panel pw-about">
        <div class="panel-h"><h3>Pit Wall On-Call</h3><span class="tag ok">Live</span></div>
        <div class="panel-b">
          <p class="pw-title">A browser game about being on call</p>
          <p class="muted">You get paged, open Monitoring, read the logs, find the cause and fix it before the error budget runs out.</p>
          <ul class="facts">
            <li><span class="tag ok">CI</span><span>Lint, typecheck, 700+ tests, Playwright</span></li>
            <li><span class="tag info">Build</span><span>SHA-tagged images to GHCR</span></li>
            <li><span class="tag info">Deploy</span><span>Over Tailscale to my homelab</span></li>
            <li><span class="tag warn">Guard</span><span><span class="mono">deploy.sh</span> smoke test, automatic rollback</span></li>
          </ul>
          <div class="actions">
            <a class="btn primary" href="https://pitwall.rafifdzaky.com">Play it<svg width="14" height="14" aria-hidden="true"><use href="#g-ext"></use></svg></a>
            <a class="btn" href="/work/pit-wall-on-call">Case study</a>
            <a class="btn" href="https://github.com/rafifdzaky27/pit-wall-on-call">Source</a>
          </div>
        </div>
      </div>
      <div class="panel logs">
        <div class="panel-h"><h3>Log stream · game day, 28 Sep 2026</h3><span class="os-chip">no player impact</span></div>
        <div class="log-lines" role="log">
          <div class="log-line"><time>09-28</time><span class="lvl INFO">INFO</span><span class="svc">ci</span><span class="msg">lint, typecheck, tests, playwright <span class="lvl PASS">PASS</span></span></div>
          <div class="log-line"><time>09-28</time><span class="lvl INFO">INFO</span><span class="svc">ghcr</span><span class="msg">push images tagged <a class="sha" href="https://github.com/rafifdzaky27/pit-wall-on-call/commit/5d73169">5d73169</a></span></div>
          <div class="log-line"><time>09-28</time><span class="lvl INFO">INFO</span><span class="svc">deploy.sh</span><span class="msg">deploy 5d73169 over tailscale</span></div>
          <div class="log-line"><time>09-28</time><span class="lvl ERROR">ERROR</span><span class="svc">smoke</span><span class="msg">smoke test failed, release 5d73169 rejected</span></div>
          <div class="log-line"><time>09-28</time><span class="lvl WARN">WARN</span><span class="svc">deploy.sh</span><span class="msg">automatic rollback to <a class="sha" href="https://github.com/rafifdzaky27/pit-wall-on-call/commit/fd8bcf9">fd8bcf9</a></span></div>
          <div class="log-line finding"><time>09-28</time><span class="lvl PASS">PASS</span><span class="svc">smoke</span><span class="msg">fd8bcf9 serving, no player impact</span></div>
        </div>
      </div>
    </div>
  </Window>

  <!-- ============ EXPERIENCE ============ -->
  <Window title="Files · ~/experience" id="experience" class="w-exp" bodyClass="naut">
    <div class="naut-bar" aria-hidden="true">
      <span class="tool-btn dim"><svg width="16" height="16"><use href="#g-back"></use></svg></span>
      <span class="naut-path"><span>rafif</span><span aria-current="location" data-crumb>experience</span></span>
    </div>
    <div class="naut-side" role="group" aria-label="Filter">
      <button type="button" class="naut-place" data-f="all" aria-pressed="true">All <span class="n">{files.length}</span></button>
      <button type="button" class="naut-place" data-f="work" aria-pressed="false">Work <span class="n">{count('work')}</span></button>
      <button type="button" class="naut-place" data-f="edu" aria-pressed="false">Education <span class="n">{count('edu')}</span></button>
      <button type="button" class="naut-place" data-f="cert" aria-pressed="false">Certificates <span class="n">{count('cert')}</span></button>
    </div>
    <div class="naut-main">
      <table class="naut-list">
        <thead><tr><th>Name</th><th>Kind</th><th>Date</th></tr></thead>
        <tbody>
          {
            files.map((f, i) => (
              <tr data-k={f.k} class="naut-row">
                <td>
                  <button type="button" class="naut-item naut-open" data-file={i} aria-haspopup="dialog" aria-controls="file-win">
                    <svg width="24" height="24" aria-hidden="true"><use href={`#${f.icon}`}></use></svg>
                    <span><b>{f.name}</b><small>{f.sub}</small></span>
                  </button>
                </td>
                <td class="kind">{f.kind}</td>
                <td class="date">{f.date}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
    <p class="naut-status" data-naut-status>{files.length} items · <a href="/resume">full CV</a></p>

    {/* One template per file; the file window shows a copy of it. */}
    {
      files.map((f, i) => (
        <template data-file-doc={i} data-title={`${f.k === 'cert' ? 'Image viewer' : 'Docs'} · ${f.name}`}>
          <article class:list={['doc', { 'has-img': f.image }]}>
            <header class="doc-head">
              <p class="kicker">{f.kind} · {f.date}</p>
              <h3>{f.name}</h3>
              <p class="doc-sub">{f.sub}</p>
            </header>
            <div class="doc-text">
              {f.points && <ul>{f.points.map((pt) => <li>{pt}</li>)}</ul>}
              {f.lines?.map((l) => <p>{l}</p>)}
              {f.link && <a class="arrow-link" href={f.link.href}>{f.link.label}</a>}
            </div>
            {f.image && (
              <a class="doc-img" href={f.image.src} aria-label={`Open the certificate for ${f.name} at full size`}>
                <Image src={f.image} alt={f.alt ?? ''} widths={[400, 800]} sizes="400px" loading="lazy" />
              </a>
            )}
          </article>
        </template>
      ))
    }
  </Window>

  <!-- The file window: opened from ~/experience, dragged by its title bar on wider screens. -->
  <section class="window file-win focused" id="file-win" role="dialog" aria-labelledby="file-win-t" hidden>
    <header class="titlebar" data-drag>
      <h2 class="titlebar-title" id="file-win-t">Docs</h2>
      <div class="titlebar-controls">
        <button type="button" class="win-x" data-file-close aria-label="Close this file">
          <svg width="16" height="16" aria-hidden="true"><use href="#g-close"></use></svg>
        </button>
      </div>
    </header>
    <div class="window-body file-win-body" data-file-body tabindex="-1"></div>
  </section>

  <!-- ============ HOMELAB ============ -->
  <Window title="Monitoring · homelab" id="homelab" class="w-side">
    <div class="lab">
      <div class="panel">
        <div class="panel-h"><h3>Service map</h3><span class="tag ok">Serving</span></div>
        <div class="svc-map" data-edges="visitors>cf,ci>ts,cf>proxmox,ts>proxmox,proxmox>site,proxmox>game">
          <svg class="svc-edges" aria-hidden="true"></svg>
          <ul class="svc-nodes labmap" aria-label="Homelab">
            <li class="svc-node" data-id="visitors"><span class="svc-name">visitors</span><span class="svc-sub"><span class="svc-detail">public HTTPS</span></span></li>
            <li class="svc-node" data-id="ci"><span class="svc-name">GitHub Actions</span><span class="svc-sub"><span class="svc-detail">deploys</span></span></li>
            <li class="svc-node" data-id="cf"><span class="svc-name">Cloudflare Tunnel</span><span class="svc-sub"><span class="svc-health ok">OK</span><span class="svc-detail">no open ports</span></span></li>
            <li class="svc-node" data-id="ts"><span class="svc-name">Tailscale</span><span class="svc-sub"><span class="svc-health ok">OK</span><span class="svc-detail">CI only</span></span></li>
            <li class="svc-node selected" data-id="proxmox"><span class="svc-name">Proxmox</span><span class="svc-sub"><span class="svc-health ok">OK</span><span class="svc-detail">one host</span></span></li>
            <li class="svc-node" data-id="site"><span class="svc-name">rafifdzaky.com</span><span class="svc-sub"><span class="svc-health ok">OK</span><span class="svc-detail">this site</span></span></li>
            <li class="svc-node" data-id="game"><span class="svc-name">Pit Wall</span><span class="svc-sub"><span class="svc-health ok">OK</span><span class="svc-detail">the game</span></span></li>
          </ul>
        </div>
      </div>
      <div class="lab-foot">
        <span><span class="tag info">Terraform</span> creates VMs</span>
        <span><span class="tag info">Ansible</span> configures</span>
        <a class="arrow-link" href="/homelab">Full map and roadmap</a>
      </div>
    </div>
  </Window>

  <!-- ============ NOTES ============ -->
  <Window title="Files · ~/notes" id="notes" class="w-side" bodyClass="naut notes">
    <div class="naut-bar" aria-hidden="true">
      <span class="tool-btn dim"><svg width="16" height="16"><use href="#g-back"></use></svg></span>
      <span class="naut-path"><span>rafif</span><span aria-current="location">notes</span></span>
    </div>
    <div class="naut-main">
      <table class="naut-list notes-list">
        <colgroup><col class="c-name" /><col /><col class="c-items" /></colgroup>
        <thead><tr><th>Name</th><th>What it is</th><th>Items</th></tr></thead>
        <tbody>
          <tr>
            <td><a class="naut-item" href="/postmortems"><svg width="24" height="24" aria-hidden="true"><use href="#f-folder"></use></svg><b>postmortems</b></a></td>
            <td class="what">Incidents from building this site, and what I changed after each one.</td>
            <td class="date">{postmortems.length}</td>
          </tr>
          <tr>
            <td><a class="naut-item" href="/decisions"><svg width="24" height="24" aria-hidden="true"><use href="#f-folder"></use></svg><b>decisions</b></a></td>
            <td class="what">The choices behind this site and their trade-offs.</td>
            <td class="date">{adrs.length}</td>
          </tr>
          <tr data-live-status>
            <td><a class="naut-item" href="/status"><svg width="24" height="24" aria-hidden="true"><use href="#f-doc"></use></svg><b>status</b></a></td>
            <td class="what" data-live-d>This site, checked from outside the homelab by a scheduled GitHub Action.</td>
            <td class="date" data-live-up>live</td>
          </tr>
          <tr>
            <td><a class="naut-item" href="/research"><svg width="24" height="24" aria-hidden="true"><use href="#f-doc"></use></svg><b>research</b></a></td>
            <td class="what">UTAUT2 pilot on POS adoption. Best Presenter, ICICoS 2026.</td>
            <td class="date">1</td>
          </tr>
        </tbody>
      </table>
    </div>
  </Window>

  <!-- ============ CONTACT ============ -->
  <Window title="Settings · contact" id="contact" class="w-full">
    <div class="contact">
      <p>Hiring for DevOps? Email is fastest.</p>
      <div class="setting-rows">
