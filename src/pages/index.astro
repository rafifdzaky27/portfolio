<script>
  import { careerStart, devopsStart, monthsSince, formatDuration } from '../data/time';
  import { initServiceMaps } from '../scripts/svc-map';
  import { ago } from '../scripts/trace';

  const set = (sel: string, v: string) => document.querySelectorAll(sel).forEach((el) => (el.textContent = v));
  set('[data-exp="total"]', formatDuration(monthsSince(careerStart)));
  set('[data-exp="devops"]', formatDuration(monthsSince(devopsStart)));

  initServiceMaps();

  // Files: the sidebar filters the list.
  const places = [...document.querySelectorAll<HTMLButtonElement>('.naut-place')];
  const rows = [...document.querySelectorAll<HTMLTableRowElement>('#experience .naut-row')];
  const crumb = document.querySelector('[data-crumb]');
  const status = document.querySelector('[data-naut-status]');
  const names: Record<string, string> = { all: 'experience', work: 'work', edu: 'education', cert: 'certificates' };
  places.forEach((p) =>
    p.addEventListener('click', () => {
      const f = p.dataset.f!;
      let n = 0;
      places.forEach((q) => q.setAttribute('aria-pressed', String(q === p)));
      rows.forEach((r) => {
        const show = f === 'all' || r.dataset.k === f;
        r.hidden = !show;
        if (show) n++;
      });
      if (crumb) crumb.textContent = names[f];
      if (status?.firstChild) status.firstChild.textContent = `${n} ${n === 1 ? 'item' : 'items'} · `;
    }),
  );

  // Files: a row opens the file in its own window. Esc or X closes it, and on
  // wider screens the title bar drags it around, like a desktop file viewer.
  const win = document.getElementById('file-win') as HTMLElement;
  const winBody = win.querySelector<HTMLElement>('[data-file-body]')!;
  const winTitle = win.querySelector<HTMLElement>('#file-win-t')!;
  const phone = matchMedia('(max-width: 640px)');
  let opener: HTMLButtonElement | null = null;
  let placed = false;

  const place = (x: number, y: number) => {
    // keep the window on screen: at least 260px of it stays visible, and its
    // height shrinks to fit below its top edge (the body scrolls)
    const w = win.offsetWidth;
    const nx = Math.min(Math.max(8, x), innerWidth - w - 8);
    const ny = Math.min(Math.max(40, y), innerHeight - 260 - 16);
    win.style.left = `${nx}px`;
    win.style.top = `${ny}px`;
    win.style.maxHeight = `${innerHeight - ny - 16}px`;
  };
  const closeFile = () => {
    if (win.hidden) return;
    win.hidden = true;
    rows.forEach((r) => r.classList.remove('current'));
    opener?.focus();
  };
  const openFile = (btn: HTMLButtonElement) => {
    const tpl = document.querySelector<HTMLTemplateElement>(`template[data-file-doc="${btn.dataset.file}"]`);
    if (!tpl) return;
    opener = btn;
    winTitle.textContent = tpl.dataset.title ?? 'Docs';
    winBody.replaceChildren(tpl.content.cloneNode(true));
    winBody.scrollTop = 0;
    rows.forEach((r) => r.classList.toggle('current', r.contains(btn)));
    win.hidden = false;
    if (!placed && !phone.matches) {
      place((innerWidth - win.offsetWidth) / 2, Math.max(60, (innerHeight - win.offsetHeight) / 2));
      placed = true;
    }
    winBody.focus({ preventScroll: true });
  };
  rows.forEach((r) => r.querySelector<HTMLButtonElement>('.naut-open')!.addEventListener('click', (e) => openFile(e.currentTarget as HTMLButtonElement)));
  win.querySelector('[data-file-close]')!.addEventListener('click', closeFile);
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && !win.hidden) closeFile();
  });

  const bar = win.querySelector<HTMLElement>('[data-drag]')!;
  bar.addEventListener('pointerdown', (e) => {
    if (phone.matches || (e.target as HTMLElement).closest('button')) return;
    const r = win.getBoundingClientRect();
    const dx = e.clientX - r.left;
    const dy = e.clientY - r.top;
    bar.setPointerCapture(e.pointerId);
    win.classList.add('dragging');
    const move = (ev: PointerEvent) => place(ev.clientX - dx, ev.clientY - dy);
    const up = () => {
      win.classList.remove('dragging');
      bar.removeEventListener('pointermove', move);
      bar.removeEventListener('pointerup', up);
      bar.removeEventListener('pointercancel', up);
    };
    bar.addEventListener('pointermove', move);
    bar.addEventListener('pointerup', up);
    bar.addEventListener('pointercancel', up);
  });
  addEventListener('resize', () => {
    if (!win.hidden && !phone.matches) place(win.offsetLeft, win.offsetTop);
  });

  // Contact: copy the email address.
  const copy = document.querySelector<HTMLButtonElement>('[data-copy-email]');
  copy?.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText('rafifdzaky27@gmail.com');
      copy.textContent = 'Copied';
      setTimeout(() => (copy.textContent = 'Copy'), 1600);
    } catch {}
  });

  // Notes: the status row shows the real uptime once it scrolls into view.
  const live = document.querySelector<HTMLElement>('[data-live-status]');
  if (live && 'IntersectionObserver' in window) {
    const io = new IntersectionObserver(async (entries) => {
      if (!entries.some((e) => e.isIntersecting)) return;
      io.disconnect();
      try {
        const res = await fetch('https://raw.githubusercontent.com/rafifdzaky27/portfolio/status/uptime.json', { cache: 'no-store' });
        const data = await res.json();
        const site = data.components?.site;
        if (!site) return;
        const days = Object.values(site.days) as { n: number; up: number }[];
        const n = days.reduce((a, d) => a + d.n, 0);
        const up = days.reduce((a, d) => a + d.up, 0);
        if (!n) return;
        const p = (100 * up) / n;
        const last = site.recent[site.recent.length - 1];
        live.querySelector('[data-live-up]')!.textContent = `${p >= 99.995 ? '100' : p.toFixed(2)}%`;
        live.querySelector('[data-live-d]')!.textContent =
          `${last?.ok ? 'Operational' : 'Failing'} · ${n} outside checks · last ${ago(data.updated)}`;
      } catch {
        /* keep the static text */
      }
    });
    io.observe(live);
  }
</script>
