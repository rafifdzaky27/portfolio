---
import '@fontsource-variable/instrument-sans/wght.css';
import '@fontsource-variable/instrument-sans/wght-italic.css';
import '@fontsource/ibm-plex-mono/latin-400.css';
import '@fontsource/ibm-plex-mono/latin-500.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Terminal from '../components/Terminal.astro';
import { person } from '../data/profile';

interface Props {
  title?: string;
  description?: string;
  current?: 'home' | 'work' | 'homelab' | 'research' | 'resume' | 'other';
  socialImage?: string;
  socialImageAlt?: string;
  ogType?: 'website' | 'article';
  noindex?: boolean;
  structuredData?: Record<string, unknown>;
}

const {
  title,
  description = 'Rafif Dzaky Daniswara is a DevOps Engineer in West Java, Indonesia: CI/CD, Linux and VPS operations, domains and SSL, monitoring and incident response for 20+ production services.',
  current = 'home',
  socialImage = '/og-image.png',
  socialImageAlt = 'Rafif Dzaky Daniswara, DevOps Engineer — infrastructure, CI/CD and monitoring',
  ogType = 'website',
  noindex = false,
  structuredData,
} = Astro.props;

const fullTitle = title ? `${title} · ${person.name}` : `${person.name} — DevOps Engineer`;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
const imageUrl = Astro.site ? new URL(socialImage, Astro.site).href : undefined;
const jsonLd = structuredData ? JSON.stringify(structuredData).replace(/</g, '\\u003c') : undefined;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>document.documentElement.classList.add('js');</script>
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={person.name} />
    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content="#f6f1e7" />
    {noindex && <meta name="robots" content="noindex, follow" />}
    {!noindex && canonical && <link rel="canonical" href={canonical} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={person.name} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    {imageUrl && <meta property="og:image" content={imageUrl} />}
    {imageUrl && <meta property="og:image:secure_url" content={imageUrl} />}
    {imageUrl && <meta property="og:image:type" content="image/png" />}
    {imageUrl && <meta property="og:image:width" content="1200" />}
    {imageUrl && <meta property="og:image:height" content="630" />}
    {imageUrl && <meta property="og:image:alt" content={socialImageAlt} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    {imageUrl && <meta name="twitter:image" content={imageUrl} />}
    {imageUrl && <meta name="twitter:image:alt" content={socialImageAlt} />}
    {jsonLd && <script type="application/ld+json" set:html={jsonLd} />}
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Header current={current} />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <Terminal />
    <script>
      // For whoever opens DevTools.
      console.log(
        "%c rafif.ops %c DevOps Engineer · served from a homelab through Cloudflare Tunnel → Caddy",
        "background:#0f766e;color:#fff;padding:2px 6px;border-radius:3px;font-weight:600",
        "color:inherit",
      );
      console.log(
        ['Hiring? rafifdzaky27@gmail.com', 'In a real terminal: curl -sL rafifdzaky.com', 'On this page: press / for a shell.'].join('\n'),
      );
    </script>
  </body>
</html>
