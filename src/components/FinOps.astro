---
// What running this site costs, with every assumption on screen.
import { finops } from '../data/ops';
const a = finops.assumptions;
const kwh = (w: number) => (w * 24 * 30.4) / 1000;
const power = kwh(a.watts) * a.tariff;
const domain = (a.domainUsdYear / 12) * a.usdToIdr;
const rp = (n: number) => `Rp ${Math.round(n / 100) * 100 > 0 ? (Math.round(n / 100) * 100).toLocaleString('id-ID') : '0'}`;
---

<article class="fin ticket" data-fin data-a={JSON.stringify(a)} aria-labelledby="fin-t">
  <header class="fin-head">
    <p class="meta">FinOps · what this site costs to run</p>
    <span class="est">estimate</span>
  </header>
  <div class="fin-grid">
    <div>
      <h3 id="fin-t" class="fin-total"><span data-fin-total>{rp(power + domain)}</span><small> / month</small></h3>
      <p class="fin-usd meta" data-fin-usd>≈ US${((power + domain) / a.usdToIdr).toFixed(2)}</p>
      <p class="fin-why">
        The lab host runs anyway, so the site's own extra cost is mostly the domain. Free hosting would be cheaper still. I
        pay the difference to run production-style infrastructure myself.
      </p>
    </div>

    <dl class="fin-items">
      <div>
        <dt>
          Electricity, whole lab host
          <label class="fin-w">
            <input type="range" min="10" max="150" step="5" value={a.watts} data-fin-watts aria-label="Average power draw of the lab host, in watts" />
            <output data-fin-wout>{a.watts} W</output>
          </label>
        </dt>
        <dd data-fin-power>{rp(power)}</dd>
      </div>
      <div>
        <dt>Domain (.com, ~US${a.domainUsdYear}/yr)</dt>
        <dd>{rp(domain)}</dd>
      </div>
      {
        finops.free.map((f) => (
          <div>
            <dt>
              {f.name} <span class="meta">{f.note}</span>
            </dt>
            <dd>Rp 0</dd>
          </div>
        ))
      }
    </dl>
  </div>

  <p class="fin-cmp meta">
    Compared with:
    {finops.compare.map((c) => <span><b>{c.name}</b> US${c.usd}/mo, {c.note}</span>)}
  </p>
  <p class="fin-ass meta">
    Assumptions: host draw {a.watts} W average (drag to change); PLN household tariff Rp {a.tariff.toLocaleString('id-ID')}/kWh;
    US$1 = Rp {a.usdToIdr.toLocaleString('id-ID')}.
  </p>
</article>

<style>
  .fin {
    margin-top: var(--s-5);
    padding: var(--s-5) var(--s-6);
  }

  .fin-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .est {
    padding: 0.1rem 0.5rem;
    border: var(--hair) dashed var(--partial-ink);
    border-radius: var(--radius);
    font: 500 0.72rem / 1.4 var(--font-mono);
    color: var(--partial-ink);
  }

  .fin-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: var(--s-6);
    margin-top: var(--s-3);
  }

  .fin-total {
    font-size: var(--step-3);
    font-variant-numeric: tabular-nums;
  }

  .fin-total small {
    font-size: var(--step-0);
    font-weight: 500;
    color: var(--muted);
  }

  .fin-why {
    margin-top: var(--s-3);
    color: var(--muted);
  }

  .fin-items {
    display: grid;
    align-content: start;
  }

  .fin-items > div {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--s-4);
    padding: 0.55rem 0;
    border-bottom: var(--hair) solid var(--line);
  }

  .fin-items dd {
    font: 500 0.9rem / 1.3 var(--font-mono);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .fin-w {
    display: flex;
    align-items: center;
    gap: var(--s-2);
    margin-top: 0.3rem;
  }

  .fin-w input {
    width: 9rem;
    accent-color: var(--accent);
  }

  .fin-w output {
    font: 400 0.8rem / 1 var(--font-mono);
    color: var(--muted);
  }

  :global(html:not(.js)) .fin-w {
    display: none;
  }

  .fin-cmp {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-1) var(--s-4);
    margin-top: var(--s-4);
  }

  .fin-cmp b {
    color: var(--ink);
    font-weight: 500;
  }

  .fin-ass {
    margin-top: var(--s-2);
    font-size: 0.75rem;
  }

  @media (max-width: 52rem) {
    .fin {
      padding: var(--s-5);
    }
    .fin-grid {
      grid-template-columns: 1fr;
      gap: var(--s-4);
    }
  }
</style>

<script>
  const card = document.querySelector<HTMLElement>('[data-fin]');
  if (card) {
    const a = JSON.parse(card.dataset.a!);
    const slider = card.querySelector<HTMLInputElement>('[data-fin-watts]')!;
    const out = card.querySelector<HTMLElement>('[data-fin-wout]')!;
    const powerEl = card.querySelector<HTMLElement>('[data-fin-power]')!;
    const totalEl = card.querySelector<HTMLElement>('[data-fin-total]')!;
    const usdEl = card.querySelector<HTMLElement>('[data-fin-usd]')!;
    const rp = (n: number) => `Rp ${(Math.round(n / 100) * 100).toLocaleString('id-ID')}`;
    const domain = (a.domainUsdYear / 12) * a.usdToIdr;
    slider.addEventListener('input', () => {
      const w = +slider.value;
      const power = ((w * 24 * 30.4) / 1000) * a.tariff;
      out.textContent = `${w} W`;
      powerEl.textContent = rp(power);
      totalEl.textContent = rp(power + domain);
      usdEl.textContent = `≈ US$${((power + domain) / a.usdToIdr).toFixed(2)}`;
    });
  }
</script>
