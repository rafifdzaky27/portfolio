---
// PitOS wallpapers, copied from the Pit Wall On-Call client (os/brand/Wallpaper.tsx).
// Dark theme: Jakarta at dusk. Light theme: Yogyakarta by day.
---

<div class="wall" aria-hidden="true">
  <svg class="wp-dark" viewBox="0 0 1600 1000" preserveAspectRatio="xMidYMid slice">
    <defs>
      <linearGradient id="wp-jakarta" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#2a2140"></stop>
        <stop offset="0.55" stop-color="#b8503f"></stop>
        <stop offset="1" stop-color="#f0a35e"></stop>
      </linearGradient>
    </defs>
    <rect width="1600" height="1000" fill="url(#wp-jakarta)"></rect>
    <circle cx="1210" cy="640" r="96" fill="#f7c873" opacity="0.85"></circle>
    <g fill="#231b31">
      <rect x="60" y="560" width="150" height="440"></rect>
      <rect x="230" y="470" width="110" height="530"></rect>
      <rect x="360" y="610" width="170" height="390"></rect>
      <path d="M784 300l16-44 16 44v320h-32z"></path>
      <rect x="740" y="620" width="120" height="30"></rect>
      <rect x="700" y="650" width="200" height="350"></rect>
      <rect x="940" y="520" width="140" height="480"></rect>
      <rect x="1100" y="600" width="120" height="400"></rect>
      <rect x="1240" y="450" width="160" height="550"></rect>
      <rect x="1420" y="580" width="180" height="420"></rect>
    </g>
    <rect y="880" width="1600" height="120" fill="#1a1426"></rect>
  </svg>
  <svg class="wp-light" viewBox="0 0 1600 1000" preserveAspectRatio="xMidYMid slice">
    <defs>
      <linearGradient id="wp-yogyakarta" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#f3d3a2"></stop>
        <stop offset="0.6" stop-color="#e7b98a"></stop>
        <stop offset="1" stop-color="#9fbfa7"></stop>
      </linearGradient>
    </defs>
    <rect width="1600" height="1000" fill="url(#wp-yogyakarta)"></rect>
    <g fill="#efe7d6" opacity="0.9">
      <circle cx="905" cy="250" r="34"></circle>
      <circle cx="950" cy="215" r="44"></circle>
      <circle cx="1005" cy="190" r="38"></circle>
    </g>
    <path d="M430 760L880 300h60l470 460z" fill="#6a7f6c"></path>
    <path d="M880 300h60l-20 40-14-18-12 22z" fill="#4e5e50"></path>
    <path d="M0 760h1600v240H0z" fill="#7aa183"></path>
    <path d="M0 820h1600v24H0zM0 880h1600v24H0zM0 940h1600v24H0z" fill="#6a946f"></path>
    <path d="M180 700l120-70h180l120 70z" fill="#3b2c1e"></path>
    <path d="M230 700h320v70H230z" fill="#5a4330"></path>
  </svg>
</div>
