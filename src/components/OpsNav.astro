---
// Tabs between the notes pages, drawn like a PitOS segmented control.
interface Props {
  current: 'postmortems' | 'decisions' | 'first-90-days' | 'status';
}
const { current } = Astro.props;
const tabs = [
  { id: 'postmortems', label: 'Postmortems' },
  { id: 'decisions', label: 'Decisions' },
  { id: 'first-90-days', label: 'First 90 days' },
  { id: 'status', label: 'Status' },
];
---

<nav class="opsnav" aria-label="Notes">
  <ul>
    {
      tabs.map((t) => (
        <li>
          <a href={`/${t.id}`} aria-current={t.id === current ? 'page' : undefined}>
            {t.label}
          </a>
        </li>
      ))
    }
  </ul>
</nav>

<style>
  .opsnav {
    max-width: 100%;
    overflow-x: auto;
  }

  ul {
    display: flex;
    gap: 2px;
    width: max-content;
    padding: 2px;
    border-radius: var(--radius-md);
    background: var(--sunken);
    list-style: none;
  }

  a {
    display: block;
    padding: 4px 12px;
    border-radius: var(--radius-sm);
    color: var(--muted);
    font: 500 var(--fs-sm) / 1.5 var(--font);
    text-decoration: none;
    white-space: nowrap;
  }

  a:hover {
    color: var(--text);
  }

  a[aria-current='page'] {
    background: var(--panel);
    color: var(--text);
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.25);
  }
</style>
