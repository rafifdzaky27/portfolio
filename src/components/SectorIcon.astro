---
// Original, generic icons for the Off the clock sectors. They're placeholders:
// if official logo files are supplied, pass them to the sector as `logo` instead.
interface Props {
  kind: 'f1' | 'football' | 'tennis';
}
const { kind } = Astro.props;
---

<span class={`si si--${kind}`} aria-hidden="true">
  {
    kind === 'f1' && (
      <svg viewBox="0 0 48 48" width="48" height="48">
        <path d="M10 6v38" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" />
        <g>
          <rect x="11" y="8" width="28" height="20" rx="1.5" fill="var(--card)" stroke="currentColor" stroke-width="2" />
          {[0, 1, 2, 3].flatMap((r) =>
            [0, 1, 2, 3, 4, 5, 6].map((c) =>
              (r + c) % 2 === 0 ? <rect x={11 + c * 4} y={8 + r * 5} width="4" height="5" fill="currentColor" /> : null,
            ),
          )}
        </g>
      </svg>
    )
  }
  {
    kind === 'football' && (
      <svg viewBox="0 0 48 48" width="48" height="48">
        <circle cx="24" cy="24" r="18" fill="var(--card)" stroke="currentColor" stroke-width="2.5" />
        <path d="M24 15l7 5-2.7 8.2h-8.6L17 20z" fill="currentColor" />
        <path
          d="M24 15V7.5M31 20l7.4-2.7M28.3 28.2l4.6 6.8M19.7 28.2l-4.6 6.8M17 20l-7.4-2.7"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
        />
      </svg>
    )
  }
  {
    kind === 'tennis' && (
      <svg viewBox="0 0 48 48" width="48" height="48">
        <circle cx="24" cy="24" r="18" fill="#d9e36a" stroke="currentColor" stroke-width="2.5" />
        <path d="M11.5 11.5c7 5 7 20 0 25M36.5 11.5c-7 5-7 20 0 25" fill="none" stroke="#fff" stroke-width="2.5" stroke-linecap="round" />
      </svg>
    )
  }
</span>

<style>
  .si {
    display: inline-grid;
    place-items: center;
    width: 3.25rem;
    height: 3.25rem;
    color: var(--ink);
  }

  .si--football {
    color: var(--stamp);
  }

  .si svg {
    width: 100%;
    height: 100%;
  }
</style>
