---
import { Image } from 'astro:assets';
import SectorIcon from './SectorIcon.astro';
import { offTheClock, lapTime, sessionClock, logoF1, person } from '../data/profile';

// Pin anchor on the circuit for each sector (viewBox units).
const pins: Record<string, [number, number]> = { S1: [200, 170], S2: [781, 215], S3: [150, 394] };
const first = offTheClock[0];
const radioData = Object.fromEntries(offTheClock.map((s) => [s.key, { ...s.radio, sector: s.sector }]));

// Deterministic soundwave heights (0.2–1).
const bars = Array.from({ length: 34 }, (_, i) => +(0.25 + 0.75 * Math.abs(Math.sin(i * 0.9) * Math.cos(i * 0.37))).toFixed(2));

const tennisBall = `<svg viewBox="0 0 48 48" width="22" height="22" aria-hidden="true"><circle cx="24" cy="24" r="18" fill="#d9e36a"/><path d="M11.5 11.5c7 5 7 20 0 25M36.5 11.5c-7 5-7 20 0 25" fill="none" stroke="#fff" stroke-width="3"/></svg>`;
---

<div class="otc" data-otc data-active={first.key} data-radio={JSON.stringify(radioData)}>
  <!-- ============ left: timing tower + team radio ============ -->
  <div class="otc-left">
    <div class="tower" role="group" aria-label="Timing tower. Choose a row to see that interest.">
      <div class="tower-head">
        <Image src={logoF1} alt="Formula 1" height={22} format="webp" class="f1-logo" />
        <span class="clock">{sessionClock}</span>
        <span class="sess">Q3 · Off the clock GP</span>
      </div>
      {
        offTheClock.map((s, i) => (
          <button
            type="button"
            class={`row ${i === 0 ? 'is-on' : ''} ${s.inPit ? 'in-pit' : ''}`}
            data-key={s.key}
            aria-pressed={i === 0 ? 'true' : 'false'}
            aria-controls={`otc-${s.key}`}
            style={`--team:${s.teamColour}`}
          >
            <span class={`pos ${s.pos === 1 ? 'pos--lead' : ''}`}>{s.pos}</span>
            <span class="badge">
              {s.badge ? <Image src={s.badge} alt="" height={44} format="webp" /> : <Fragment set:html={tennisBall} />}
            </span>
            <span class="code">{s.code}</span>
            <span class="gap">{s.gap}</span>
            <span class={`tyre tyre--${s.tyre}`} title={s.tyreName}>{s.tyre}</span>
            <span class="pit">{s.inPit ? 'P' : ''}</span>
            <span class="visually-hidden">
              : {s.title}, {s.sector} {s.status}
            </span>
          </button>
        ))
      }
    </div>

    <div class="flap" aria-hidden="true">
      <p class="flap-h"><span>Fastest lap</span><b>{first.code} · {lapTime}</b></p>
      <div class="flap-ms">
        {offTheClock.map((s) => <i class={`ms ms--${s.colour}`} />)}
      </div>
    </div>

    <div class="radio">
      <div class="radio-head">
        <button type="button" class="radio-sound" data-sound="on" aria-pressed="true" aria-label="Team radio sound">
          <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
            <path d="M4 9h3l5-4v14l-5-4H4z" fill="currentColor"></path>
            <path class="rs-on" d="M15.5 8.5a5 5 0 0 1 0 7M18 6a8.5 8.5 0 0 1 0 12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path>
            <path class="rs-off" d="M16 9l5 6M21 9l-5 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path>
          </svg>
          <span class="rs-text">Sound on</span>
        </button>
        <p class="radio-name">{person.name.split(' ')[0]}</p>
        <p class="radio-sub">
          <Image src={first.badge!} alt="" height={40} format="webp" class="radio-bulls" />
          <span>Radio</span>
        </p>
      </div>
      <div class="wave" aria-hidden="true">
        {bars.map((h, i) => <i style={`--h:${h};--d:${(i % 7) * 90}ms`} />)}
      </div>
      <div class="radio-body" aria-live="polite">
        <p class="msg msg--driver" data-radio="driver">"{first.radio.driver}"</p>
        <p class="msg msg--reply" data-radio="reply">"{first.radio.reply}"</p>
      </div>
    </div>
  </div>

  <!-- ============ right: circuit + infield card ============ -->
  <div class="otc-right">
    <svg class="circuit" viewBox="0 0 820 460" role="img" aria-label="Circuit split into three sectors: S1 Formula 1, S2 Liverpool, S3 tennis.">
      <path class="base" d="M70 370 C10 370 10 260 70 235 L300 120 C360 90 390 60 450 70 L660 110 C760 130 800 210 770 290 C745 355 660 370 590 355 L470 328 C415 316 395 382 345 390 L130 395 C100 395 82 382 70 370 Z"></path>
      <path class="sec sec--purple" data-sector="S1" d="M70 370 C10 370 10 260 70 235 L300 120 C360 90 390 60 450 70"></path>
      <path class="sec sec--green" data-sector="S2" d="M450 70 L660 110 C760 130 800 210 770 290 C745 355 660 370 590 355"></path>
      <path class="sec sec--yellow" data-sector="S3" d="M590 355 L470 328 C415 316 395 382 345 390 L130 395 C100 395 82 382 70 370"></path>
      <rect x="62" y="352" width="7" height="36" class="finish"></rect>
      <text class="lab lab--purple" x="110" y="160">S1 {offTheClock[0].time}</text>
      <text class="lab lab--green" x="650" y="92">S2 {offTheClock[1].time}</text>
      <text class="lab lab--yellow" x="110" y="436">S3 {offTheClock[2].time}</text>
      <g class="pin" style={`transform: translate(${pins.S1[0]}px, ${pins.S1[1]}px)`} data-pins={JSON.stringify(pins)}>
        <circle r="16"></circle>
        <text y="6">3</text>
      </g>
    </svg>
    <ul class="corner" aria-label="Sector colours">
      <li><i class="k k--purple"></i>fastest</li>
      <li><i class="k k--green"></i>personal best</li>
      <li><i class="k k--yellow"></i>improving</li>
    </ul>

    <div class="cards">
      {
        offTheClock.map((s, i) => (
          <article class={`card ${i === 0 ? 'is-on' : ''}`} id={`otc-${s.key}`} data-card={s.key}>
            <p class="card-top">
              <span class={`chip chip--${s.colour}`}>
                P{s.pos} · {s.sector}
              </span>
              <span class="card-status">
                {s.status} · {s.tyreName}
              </span>
            </p>
            <div class={`card-logo ${s.logoWide ? 'is-wide' : ''}`}>
              {s.logo ? (
                <Image src={s.logo} alt={s.logoAlt ?? ''} {...(s.logoWide ? { width: 520 } : { height: 150 })} format="webp" loading="lazy" />
              ) : (
                <SectorIcon kind={s.icon} />
              )}
            </div>
            <p class="card-kind">Hobby {s.pos} of {offTheClock.length}</p>
            <h3>{s.title}</h3>
            <p class="card-line">{s.line}</p>
            <p class="card-note">{s.note}</p>
          </article>
        ))
      }
    </div>
  </div>
</div>


<style>
  .otc {
    --purple: #a020f0;
    --green: #00c16a;
    --yellow: #ffcf1f;
    --tv: #15151e;
    --tv-deep: #0b0b10;
    --rb-navy: #0f1a3d;
    --rb-blue: #3671c6;
    --rb-sky: #6fa0ec;
    --soft: #e8002d;
    --med: #ffd12e;
    display: grid;
    grid-template-columns: 26rem minmax(0, 1fr);
    margin-top: var(--s-6);
    border: var(--rule) solid var(--ink);
    border-radius: var(--radius-ticket);
    overflow: hidden;
    background: var(--card);
  }

  /* ================= left ================= */
  .otc-left {
    display: flex;
    flex-direction: column;
    gap: var(--s-3);
    padding: var(--s-4);
    background: var(--tv);
    color: #fff;
  }

  .tower {
    overflow: hidden;
    border-radius: 8px;
    background: var(--tv-deep);
  }

  .tower-head {
    display: grid;
    justify-items: center;
    gap: 0.3rem;
    padding: 0.9rem 0 0.7rem;
    background: linear-gradient(#1c1c27, var(--tv-deep));
  }

  .tower-head :global(.f1-logo) {
    width: auto;
    height: 1.35rem;
  }

  .clock {
    font: 700 1.4rem / 1 var(--font-sans);
    font-variant-numeric: tabular-nums;
  }

  .sess {
    font: 500 0.66rem / 1 var(--font-mono);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    opacity: 0.7;
  }

  .row {
    display: grid;
    grid-template-columns: 1.75rem 2rem minmax(0, 1fr) auto 1rem 1.15rem;
    align-items: center;
    gap: 0.65rem;
    width: 100%;
    padding: 0.6rem 0.75rem;
    border: 0;
    border-top: 1px solid rgba(255, 255, 255, 0.07);
    background: transparent;
    color: #fff;
    font: 700 1.05rem / 1 var(--font-sans);
    letter-spacing: 0.02em;
    text-align: left;
    cursor: pointer;
    transition: background-color var(--dur-fast) var(--ease);
  }

  .row:hover {
    background: #1a1a24;
  }

  .row.is-on {
    background: #22222e;
    box-shadow: inset 3px 0 0 var(--team);
  }

  .row:focus-visible {
    outline: 2px solid var(--rb-sky);
    outline-offset: -2px;
  }

  .row.in-pit .code,
  .row.in-pit .gap {
    opacity: 0.75;
  }

  .pos {
    display: grid;
    place-items: center;
    height: 1.6rem;
    font-size: 0.95rem;
  }

  .pos--lead {
    background: var(--soft);
  }

  .badge {
    display: grid;
    place-items: center;
    height: 1.4rem;
  }

  .badge :global(img) {
    width: auto;
    max-width: 2rem;
    max-height: 1.4rem;
  }

  .gap {
    font-weight: 600;
    font-size: 0.95rem;
    font-variant-numeric: tabular-nums;
  }

  .tyre {
    font-size: 0.8rem;
  }

  .tyre--S {
    color: var(--soft);
  }

  .tyre--M {
    color: var(--med);
  }

  .tyre--H {
    color: #fff;
  }

  .pit:not(:empty) {
    display: grid;
    place-items: center;
    width: 1.1rem;
    height: 1.1rem;
    background: #fff;
    color: var(--tv-deep);
    font-size: 0.7rem;
    font-weight: 800;
  }

  /* fastest lap banner fills the gap between tower and radio */
  .flap {
    padding: 0.6rem 0.75rem;
    border-radius: 6px;
    background: linear-gradient(90deg, #3b0f5a, #1a1a26 70%);
  }

  .flap-h {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    font: 500 0.7rem / 1.4 var(--font-mono);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .flap-h b {
    font: 700 1rem / 1 var(--font-sans);
    letter-spacing: 0.02em;
    color: #e2b3ff;
    font-variant-numeric: tabular-nums;
  }

  .flap-ms {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 3px;
    margin-top: 0.5rem;
  }

  .ms {
    height: 5px;
    border-radius: 1px;
  }

  .ms--purple {
    background: var(--purple);
  }

  .ms--green {
    background: var(--green);
  }

  .ms--yellow {
    background: var(--yellow);
  }

  /* ---- team radio (broadcast style) ---- */
  .radio {
    margin-top: auto;
    overflow: hidden;
    border: 2px solid #8fb4ea;
    border-radius: 6px;
    background: linear-gradient(180deg, #16244f, var(--rb-navy) 55%);
    font-style: italic;
  }

  .radio-head {
    padding: 0.7rem 1rem 0.2rem;
    text-align: center;
    background: linear-gradient(180deg, #1e3170, #16244f);
  }

  .radio-head {
    position: relative;
  }

  .radio-sound {
    position: absolute;
    top: 0.5rem;
    right: 0.5rem;
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.25rem 0.5rem 0.25rem 0.4rem;
    border: 1px solid rgba(143, 180, 234, 0.55);
    border-radius: 999px;
    background: rgba(11, 11, 16, 0.35);
    color: #cfe0ff;
    font: normal 500 0.6rem / 1 var(--font-mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    cursor: pointer;
  }

  .radio-sound:hover {
    background: rgba(143, 180, 234, 0.18);
  }

  .radio-sound:focus-visible {
    outline: 2px solid var(--rb-sky);
    outline-offset: 2px;
  }

  .radio-sound .rs-off,
  .radio-sound[data-sound='off'] .rs-on {
    display: none;
  }

  .radio-sound[data-sound='off'] .rs-off {
    display: inline;
  }

  .radio-sound[data-sound='off'] {
    color: rgba(207, 224, 255, 0.6);
  }

  .radio-sound[data-sound='blocked'] {
    border-color: #cfe0ff;
    background: var(--rb-blue);
    color: #fff;
  }

  @media (prefers-reduced-motion: no-preference) {
    .radio-sound[data-sound='blocked'] {
      animation: nudge 1.6s ease-in-out infinite;
    }
    @keyframes nudge {
      50% {
        box-shadow: 0 0 0 5px rgba(111, 160, 236, 0.3);
      }
    }
  }

  :global(html:not(.js)) .radio-sound {
    display: none;
  }

  /* narrow cards: the pill gets its own line above the name */
  @media (max-width: 30rem) {
    .radio-sound {
      position: static;
      margin-bottom: 0.45rem;
    }
  }

  .radio-name {
    font: italic 800 1.55rem / 1 var(--font-sans);
    letter-spacing: 0.01em;
    text-transform: uppercase;
    color: var(--rb-sky);
  }

  .radio-sub {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font: italic 800 1.55rem / 1.1 var(--font-sans);
    text-transform: uppercase;
  }

  .radio-sub :global(.radio-bulls) {
    width: auto;
    height: 1.2rem;
  }

  .wave {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 3px;
    height: 2.1rem;
    padding: 0 1rem;
    background: linear-gradient(180deg, #16244f, #0f1a3d);
    border-bottom: 1px solid rgba(143, 180, 234, 0.35);
  }

  .wave i {
    width: 3px;
    height: 100%;
    border-radius: 2px;
    background: linear-gradient(#b9d3ff, var(--rb-blue));
    transform: scaleY(var(--h));
    transform-origin: center;
  }

  /* the reply comes in once the driver has finished talking */
  .otc.is-waiting .msg--reply {
    opacity: 0.2;
  }

  @media (prefers-reduced-motion: no-preference) {
    .otc.is-talking:not(.is-live) .wave i {
      animation: talk 0.55s var(--d) ease-in-out infinite alternate;
    }
    @keyframes talk {
      from {
        transform: scaleY(calc(var(--h) * 0.25));
      }
      to {
        transform: scaleY(var(--h));
      }
    }
    .msg {
      transition: opacity var(--dur) var(--ease);
    }
    .otc.is-switching .msg {
      opacity: 0;
    }
  }

  .radio-body {
    display: grid;
    gap: 0.8rem;
    padding: 0.9rem 1rem 1rem;
  }

  .msg {
    font: italic 800 1.02rem / 1.15 var(--font-sans);
    letter-spacing: 0.005em;
    text-transform: uppercase;
  }

  .msg--driver {
    text-align: right;
    color: var(--rb-sky);
  }

  .msg--reply {
    color: #fff;
  }

  /* ================= right ================= */
  .otc-right {
    position: relative;
    min-height: 36rem;
  }

  .circuit {
    position: absolute;
    inset: 0.75rem;
    width: calc(100% - 1.5rem);
    height: calc(100% - 1.5rem);
  }

  .base {
    fill: none;
    stroke: #e4ddcf;
    stroke-width: 30;
    stroke-linejoin: round;
  }

  .sec {
    fill: none;
    stroke-width: 10;
    stroke-linecap: round;
    transition:
      stroke-width var(--dur) var(--ease),
      opacity var(--dur) var(--ease);
  }

  .sec--purple {
    stroke: var(--purple);
  }

  .sec--green {
    stroke: var(--green);
  }

  .sec--yellow {
    stroke: var(--yellow);
  }

  .sec.is-on {
    stroke-width: 14;
  }

  .sec.is-off {
    opacity: 0.45;
  }

  .finish {
    fill: var(--tv);
  }

  .lab {
    font: 400 14px var(--font-mono);
  }

  .lab--purple {
    fill: #8a17cf;
  }

  .lab--green {
    fill: #00924f;
  }

  .lab--yellow {
    fill: #a88400;
  }

  .pin {
    transition: transform 0.7s var(--ease);
  }

  .pin circle {
    fill: var(--rb-navy);
    stroke: #fff;
    stroke-width: 3;
  }

  .pin text {
    fill: #fff;
    font: italic 800 15px var(--font-sans);
    text-anchor: middle;
  }

  .corner {
    position: absolute;
    top: 1.1rem;
    right: 1.4rem;
    display: flex;
    gap: var(--s-3);
    list-style: none;
    font: 400 0.75rem / 1 var(--font-mono);
    color: var(--muted);
  }

  .corner li {
    display: flex;
    align-items: center;
    gap: 0.35rem;
  }

  .k {
    width: 0.65rem;
    height: 0.65rem;
    border-radius: 2px;
  }

  .k--purple {
    background: var(--purple);
  }

  .k--green {
    background: var(--green);
  }

  .k--yellow {
    background: var(--yellow);
  }

  /* infield card */
  .cards {
    position: absolute;
    left: 29%;
    top: 29%;
    width: 46%;
  }

  .card {
    display: none;
    padding: var(--s-4) var(--s-5);
    border: var(--rule) solid var(--ink);
    border-radius: 14px;
    background: var(--paper);
    box-shadow: 0 18px 30px -24px rgba(0, 0, 0, 0.4);
  }

  .card.is-on {
    display: block;
  }

  :global(html:not(.js)) .card {
    display: block;
  }

  :global(html:not(.js)) .card + .card {
    margin-top: var(--s-3);
  }

  .card-top {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-2) var(--s-3);
  }

  .chip {
    padding: 0.2rem 0.5rem;
    border-radius: 3px;
    font: 600 0.78rem / 1.3 var(--font-mono);
  }

  .chip--purple {
    background: var(--purple);
    color: #fff;
  }

  .chip--green {
    background: var(--green);
    color: var(--tv);
  }

  .chip--yellow {
    background: var(--yellow);
    color: var(--tv);
  }

  .card-status {
    font: 500 0.72rem / 1.3 var(--font-mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .card-logo {
    display: flex;
    align-items: center;
    height: 5rem;
    margin: var(--s-3) 0;
  }

  .card-logo :global(img) {
    width: auto;
    height: 100%;
    object-fit: contain;
  }

  .card-logo.is-wide :global(img) {
    width: 100%;
    height: auto;
    max-height: 100%;
  }

  .card-logo :global(.si) {
    width: 4.5rem;
    height: 4.5rem;
  }

  .card-kind {
    font: 500 0.72rem / 1.3 var(--font-mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .card h3 {
    font-size: var(--step-2);
  }

  .card-line {
    margin-top: var(--s-1);
    font-size: 0.95rem;
    color: var(--muted);
  }

  .card-note {
    margin-top: var(--s-2);
    font: 400 0.78rem / 1.4 var(--font-mono);
    color: var(--muted);
  }

  /* ================= responsive ================= */
  @media (max-width: 64rem) {
    .otc {
      grid-template-columns: 1fr;
    }
    .otc-right {
      min-height: 0;
      padding: var(--s-4);
    }
    .circuit {
      position: static;
      width: 100%;
      height: auto;
      margin-top: var(--s-5);
    }
    .corner {
      top: var(--s-4);
      left: var(--s-4);
      right: auto;
    }
    .cards {
      position: static;
      width: auto;
      margin-top: var(--s-3);
    }
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>('[data-otc]');
  const data = JSON.parse(root?.dataset.radio || '{}');

  if (root) {
    const rows = [...root.querySelectorAll<HTMLButtonElement>('.row')];
    const cards = [...root.querySelectorAll<HTMLElement>('[data-card]')];
    const secs = [...root.querySelectorAll<SVGPathElement>('.sec')];
    const pin = root.querySelector<SVGGElement>('.pin')!;
    const pins = JSON.parse(pin.dataset.pins || '{}');
    const driver = root.querySelector('[data-radio="driver"]')!;
    const reply = root.querySelector('[data-radio="reply"]')!;
    const soundBtn = root.querySelector<HTMLButtonElement>('.radio-sound')!;
    const soundText = soundBtn.querySelector('.rs-text')!;
    const bars = [...root.querySelectorAll<HTMLElement>('.wave i')];
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
    let talkTimer: number | undefined;

    /* ---------- team radio audio ----------
       One <audio> element for the whole board, so two clips can never overlap.
       It plays when the board comes into view, switches clip when another row
       is chosen, and stops as soon as the board leaves the screen or the tab
       is hidden. Browsers only allow sound after the visitor has interacted
       with the page, so if autoplay is refused the button asks for a tap. */
    const audio = new Audio();
    audio.preload = 'none';
    audio.volume = 0.7;
    let soundOn = true;
    try {
      soundOn = localStorage.getItem('otc-radio') !== 'off';
    } catch {}
    let inView = false;

    const setSound = (state: 'on' | 'off' | 'blocked') => {
      soundBtn.dataset.sound = state;
      soundBtn.setAttribute('aria-pressed', String(state !== 'off'));
      soundText.textContent = state === 'on' ? 'Sound on' : state === 'off' ? 'Muted' : 'Tap to listen';
    };
    setSound(soundOn ? 'on' : 'off');

    // Real-signal soundwave: an analyser drives the bars while a clip plays.
    // Only set up inside a click or keypress, because an AudioContext created
    // without one starts suspended and would silence the clip.
    let analyser: AnalyserNode | undefined;
    let ctx: AudioContext | undefined;
    let raf = 0;
    const hookAnalyser = () => {
      if (analyser || reduce.matches || !('AudioContext' in window)) return;
      try {
        ctx = new AudioContext();
        const src = ctx.createMediaElementSource(audio);
        analyser = ctx.createAnalyser();
        analyser.fftSize = 128;
        analyser.smoothingTimeConstant = 0.6;
        src.connect(analyser);
        analyser.connect(ctx.destination);
      } catch {
        analyser = undefined;
      }
    };
    const draw = () => {
      if (!analyser) return;
      const bins = new Uint8Array(analyser.frequencyBinCount);
      analyser.getByteFrequencyData(bins);
      const mid = (bars.length - 1) / 2;
      bars.forEach((b, i) => {
        // speech energy sits in the low bins: put those in the middle
        const v = bins[2 + Math.round(Math.abs(i - mid) * 1.1)] / 255;
        b.style.transform = `scaleY(${Math.max(0.12, v).toFixed(2)})`;
      });
      raf = requestAnimationFrame(draw);
    };
    const stopDraw = () => {
      cancelAnimationFrame(raf);
      bars.forEach((b) => (b.style.transform = ''));
      root.classList.remove('is-live');
    };

    const stop = () => {
      if (!audio.paused) audio.pause();
      stopDraw();
      root.classList.remove('is-talking', 'is-waiting');
    };

    const play = (key: string) => {
      const url = data[key]?.audio;
      if (!soundOn || !inView || !url) return;
      stop();
      if (!audio.src.endsWith(url)) audio.src = url;
      audio.currentTime = 0;
      ctx?.resume();
      root.classList.add('is-waiting');
      audio.play().then(
        () => setSound('on'),
        (err: DOMException) => {
          root.classList.remove('is-waiting');
          if (err.name === 'NotAllowedError') setSound('blocked');
        },
      );
    };

    audio.addEventListener('playing', () => {
      window.clearTimeout(talkTimer);
      root.classList.add('is-talking');
      if (analyser && ctx?.state === 'running') {
        root.classList.add('is-live');
        cancelAnimationFrame(raf);
        draw();
      }
    });
    audio.addEventListener('ended', stop);
    audio.addEventListener('pause', stopDraw);

    // Unlock sound and the analyser on the visitor's first interaction.
    const unlock = () => {
      hookAnalyser();
      ctx?.resume();
    };
    ['pointerdown', 'keydown'].forEach((t) => document.addEventListener(t, unlock, { once: true, capture: true }));

    soundBtn.addEventListener('click', () => {
      const wasBlocked = soundBtn.dataset.sound === 'blocked';
      soundOn = wasBlocked || !soundOn;
      try {
        localStorage.setItem('otc-radio', soundOn ? 'on' : 'off');
      } catch {}
      setSound(soundOn ? 'on' : 'off');
      if (soundOn) play(root.dataset.active!);
      else stop();
    });

    // Visual-only "talking" when there's no sound.
    const talk = () => {
      if (reduce.matches || !audio.paused) return;
      root.classList.add('is-talking');
      window.clearTimeout(talkTimer);
      talkTimer = window.setTimeout(() => root.classList.remove('is-talking'), 3200);
    };

    const select = (key: string, withSound = true) => {
      const d = data[key];
      if (!d) return;
      rows.forEach((r) => {
        const on = r.dataset.key === key;
        r.classList.toggle('is-on', on);
        r.setAttribute('aria-pressed', String(on));
      });
      cards.forEach((c) => c.classList.toggle('is-on', c.dataset.card === key));
      secs.forEach((s) => {
        s.classList.toggle('is-on', s.dataset.sector === d.sector);
        s.classList.toggle('is-off', s.dataset.sector !== d.sector);
      });
      const [x, y] = pins[d.sector];
      pin.style.transform = `translate(${x}px, ${y}px)`;
      root.dataset.active = key;

      if (withSound) play(key);
      root.classList.add('is-switching');
      window.setTimeout(() => {
        driver.textContent = `"${d.driver}"`;
        reply.textContent = `"${d.reply}"`;
        root.classList.remove('is-switching');
        if (inView) talk();
      }, reduce.matches ? 0 : 180);
    };

    // Clicking the row that's already on replays its radio.
    rows.forEach((r) => r.addEventListener('click', () => select(r.dataset.key!)));

    // Up/Down arrows move through the tower like a list.
    root.querySelector('.tower')!.addEventListener('keydown', (e) => {
      const ev = e as KeyboardEvent;
      if (ev.key !== 'ArrowDown' && ev.key !== 'ArrowUp') return;
      const i = rows.indexOf(document.activeElement as HTMLButtonElement);
      if (i < 0) return;
      ev.preventDefault();
      const next = rows[(i + (ev.key === 'ArrowDown' ? 1 : rows.length - 1)) % rows.length];
      next.focus();
      select(next.dataset.key!);
    });

    select(rows[0].dataset.key!, false);

    if ('IntersectionObserver' in window) {
      // Fetch the current clip shortly before the board arrives.
      const near = new IntersectionObserver(
        (entries) => {
          if (!entries.some((e) => e.isIntersecting)) return;
          audio.preload = 'auto';
          audio.src = data[root.dataset.active!]?.audio;
          near.disconnect();
        },
        { rootMargin: '600px 0px' },
      );
      near.observe(root);

      // The radio belongs to whatever sits in the middle of the screen.
      // It starts once the board reaches the middle 20% of the viewport and
      // stops once it has left the middle 60%, so a neighbouring section that
      // takes over the screen always silences it. The gap between the two
      // bands keeps it from restarting when someone parks at the edge.
      const enter = new IntersectionObserver(
        (entries) => {
          if (inView || !entries.some((e) => e.isIntersecting)) return;
          inView = true;
          talk();
          play(root.dataset.active!);
        },
        { rootMargin: '-40% 0px -40% 0px' },
      );
      const leave = new IntersectionObserver(
        (entries) => {
          if (!inView || entries.some((e) => e.isIntersecting)) return;
          inView = false;
          stop();
          if (soundBtn.dataset.sound === 'blocked') setSound('on');
        },
        { rootMargin: '-20% 0px -20% 0px' },
      );
      enter.observe(root);
      leave.observe(root);
    }

    document.addEventListener('visibilitychange', () => {
      if (document.hidden) stop();
    });
    window.addEventListener('pagehide', stop);
  }
</script>
