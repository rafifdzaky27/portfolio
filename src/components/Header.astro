---
// PitOS top bar (shell.css .os-topbar): name on the left, section links,
// Jakarta clock in the middle, and a tray with the status chip, the terminal
// and the light/dark switch. On phones the dock at the bottom carries the links.
import LogoMark from './LogoMark.astro';

export type Current =
  | 'home'
  | 'work'
  | 'homelab'
  | 'research'
  | 'resume'
  | 'notes'
  | 'status'
  | 'other';

interface Props {
  current: Current;
}
const { current } = Astro.props;
const onHome = current === 'home';
const h = (id: string) => (onHome ? `#${id}` : `/#${id}`);

const links = [
  { href: h('work'), label: 'Work', spy: 'work', page: 'work' },
  { href: h('pitwall'), label: 'Pit Wall', spy: 'pitwall' },
  { href: h('experience'), label: 'Experience', spy: 'experience' },
  { href: '/homelab', label: 'Homelab', page: 'homelab' },
  { href: '/postmortems', label: 'Notes', page: 'notes' },
  { href: h('contact'), label: 'Contact', spy: 'contact' },
];
---

<header class="os-topbar">
  <div class="os-left">
    <a class="os-item os-brand" href="/" aria-label="Rafif Dzaky Daniswara, home">
      <LogoMark size={18} />
      <span>Rafif Dzaky</span>
    </a>
    <nav class="os-nav" aria-label="Primary">
      {
        links.map((l) => (
          <a
            class="os-item"
            href={l.href}
            data-spy={onHome ? l.spy : undefined}
            aria-current={l.page && l.page === current ? 'page' : undefined}
          >
            {l.label}
          </a>
        ))
      }
    </nav>
  </div>

  <span class="os-clock"><time data-clock>Jakarta · WIB</time></span>

  <div class="os-tray">
    <a class="oncall" href={h('contact')}>Open to <span class="long">DevOps </span>roles</a>
    <button class="os-item tray-btn" type="button" data-term-open aria-label="Open the terminal (shortcut: /)" title="Terminal ( / )">
      <svg width="16" height="16" aria-hidden="true"><use href="#g-term"></use></svg>
    </button>
    <button class="os-item tray-btn" type="button" data-theme-toggle aria-label="Switch to light theme">
      <svg class="i-sun" width="16" height="16" aria-hidden="true"><use href="#g-sun"></use></svg>
      <svg class="i-moon" width="16" height="16" aria-hidden="true"><use href="#g-moon"></use></svg>
    </button>
  </div>
</header>

<style>
  .os-topbar {
    position: sticky;
    top: 0;
    z-index: 1300;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    align-items: center;
    height: var(--topbar-h);
    padding: 0 8px;
    background: var(--topbar-bg);
    color: var(--topbar-text);
    font-size: var(--fs-sm);
  }

  .os-left {
    display: flex;
    align-items: center;
    gap: 2px;
    min-width: 0;
  }

  .os-item {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    height: 24px;
    padding: 0 10px;
    border: 0;
    border-radius: 12px;
    background: transparent;
    color: var(--topbar-text);
    font: 500 var(--fs-sm) var(--font);
    text-decoration: none;
    white-space: nowrap;
    cursor: pointer;
    transition: background var(--motion-fast);
  }

  .os-item:hover,
  .os-item[aria-current] {
    background: rgba(255, 255, 255, 0.12);
  }

  .os-item:focus-visible {
    outline: 2px solid var(--accent-hover);
    outline-offset: 1px;
  }

  .os-brand {
    padding-left: 6px;
    font-weight: 600;
  }

  .os-brand :global(.logo-mark) {
    border-radius: 4px;
    box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.22);
  }

  .os-nav {
    display: flex;
    gap: 2px;
  }

  .os-nav .os-item {
    color: #b9c0cb;
    font-weight: 400;
  }

  .os-nav .os-item[aria-current] {
    color: var(--topbar-text);
    font-weight: 500;
  }

  .os-clock {
    justify-self: center;
    font-variant-numeric: tabular-nums;
    font-weight: 500;
  }

  .os-tray {
    display: flex;
    justify-self: end;
    align-items: center;
    gap: 4px;
  }

  .oncall {
    padding: 2px 8px;
    border-radius: 10px;
    background: #73bf69;
    color: #16181d;
    font: 600 var(--fs-xs) var(--font);
    text-decoration: none;
    white-space: nowrap;
  }

  .oncall:hover {
    background: #86cc7d;
  }

  .tray-btn {
    width: 28px;
    padding: 0;
    justify-content: center;
    border-radius: 14px;
  }

  .i-moon {
    display: none;
  }

  :global(:root[data-theme='light']) .i-sun {
    display: none;
  }

  :global(:root[data-theme='light']) .i-moon {
    display: block;
  }

  @media (max-width: 1180px) {
    .os-nav {
      display: none;
    }
  }

  @media (max-width: 640px) {
    .os-topbar {
      height: 40px;
      grid-template-columns: minmax(0, 1fr) auto;
    }
    .os-clock {
      display: none;
    }
  }

  @media (max-width: 380px) {
    .oncall .long {
      display: none;
    }
  }
</style>

<script>
  // Theme: the choice is saved; the inline script in Base.astro applies it before paint.
  const root = document.documentElement;
  const btn = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
  const label = () => {
    const dark = root.dataset.theme !== 'light';
    btn?.setAttribute('aria-label', dark ? 'Switch to light theme' : 'Switch to dark theme');
  };
  btn?.addEventListener('click', () => {
    const next = root.dataset.theme === 'light' ? 'dark' : 'light';
    root.dataset.theme = next;
    try {
      localStorage.setItem('pitos-theme', next);
    } catch {}
    label();
  });
  label();

  // Clock: Jakarta time, like the PitOS top bar.
  const clock = document.querySelector<HTMLTimeElement>('[data-clock]');
  let fmt: Intl.DateTimeFormat | undefined;
  try {
    fmt = new Intl.DateTimeFormat('en-GB', {
      weekday: 'short',
      day: 'numeric',
      month: 'short',
      hour: '2-digit',
      minute: '2-digit',
      hour12: false,
      timeZone: 'Asia/Jakarta',
    });
  } catch {}
  const tick = () => {
    if (!clock || !fmt) return;
    const now = new Date();
    clock.textContent = `${fmt.format(now).replace(',', '')} WIB`;
    clock.dateTime = now.toISOString();
  };
  tick();
  setInterval(tick, 15000);

  // Scroll-spy on the home page: the link for the window in view is marked.
  const spies = [...document.querySelectorAll<HTMLAnchorElement>('[data-spy]')];
  if (spies.length) {
    const targets = spies
      .map((a) => document.getElementById(a.dataset.spy!))
      .filter((el): el is HTMLElement => !!el);
    const mark = () => {
      const mid = window.innerHeight * 0.35;
      let best: HTMLElement | undefined;
      for (const t of targets) {
        const r = t.getBoundingClientRect();
        if (r.top <= mid && r.bottom >= mid) best = t;
      }
      spies.forEach((a) =>
        a.dataset.spy === best?.id ? a.setAttribute('aria-current', 'true') : a.removeAttribute('aria-current'),
      );
    };
    let raf = 0;
    window.addEventListener('scroll', () => {
      if (!raf) raf = requestAnimationFrame(() => ((raf = 0), mark()));
    }, { passive: true });
    mark();
  }
</script>
