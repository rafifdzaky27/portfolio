---
// The contact call-to-action as a deployment approval gate, the same kind of gate
// every production release of mine waits behind. Approve opens an email.
import { person } from '../data/profile';
const subject = 'Approved: let’s talk about a role';
---

<section class="gate" aria-labelledby="gate-t" data-gate data-email={person.email}>
  <header class="gate-head">
    <span class="gate-dot" aria-hidden="true"></span>
    <h3 id="gate-t">Review pending deployment</h3>
    <span class="gate-wait" data-gate-state>Waiting for your review</span>
  </header>

  <div class="gate-body">
    <p class="gate-run">
      <span class="gate-pill">deploy</span>
      <code>rafif</code> → <code data-gate-env>your-team</code>
      <span class="gate-meta">· environment <b>production</b> · requested by rafif</span>
    </p>

    <ol class="gate-jobs" aria-label="Checks">
      <li><span aria-hidden="true">✓</span> build: 20+ services shipped through CI/CD</li>
      <li><span aria-hidden="true">✓</span> test: under 2% failed production deploys</li>
      <li><span aria-hidden="true">✓</span> security: CSP, secrets out of logs, origin behind a tunnel</li>
      <li class="is-wait"><span aria-hidden="true">●</span> approval: <b>you</b></li>
    </ol>

    <form class="gate-form" data-gate-form>
      <label>
        <span>Team or company <em>(optional)</em></span>
        <input name="team" type="text" autocomplete="organization" maxlength="60" placeholder="your-team" />
      </label>
      <label>
        <span>Comment <em>(optional)</em></span>
        <textarea name="comment" rows="3" maxlength="600" placeholder="e.g. Free for a call on Thursday at 10:00 WIB?"></textarea>
      </label>
      <div class="gate-btns">
        <button type="button" class="btn" data-gate-reject>Reject</button>
        <a class="btn btn--primary" data-gate-approve href={`mailto:${person.email}?subject=${encodeURIComponent(subject)}`}>
          Approve and deploy
        </a>
      </div>
    </form>
    <p class="gate-log meta" data-gate-log aria-live="polite"></p>
  </div>
</section>

<style>
  .gate {
    margin-top: var(--s-5);
    border: var(--rule) solid var(--ink);
    border-radius: var(--radius-ticket);
    background: var(--card);
    overflow: hidden;
  }

  .gate-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-2) var(--s-3);
    padding: var(--s-3) var(--s-5);
    border-bottom: var(--hair) solid var(--line);
    background: var(--paper);
  }

  .gate-head h3 {
    font-size: var(--step-0);
    margin-right: auto;
  }

  .gate-dot {
    width: 0.75rem;
    height: 0.75rem;
    border-radius: 50%;
    background: var(--partial);
    box-shadow: 0 0 0 3px rgba(178, 122, 18, 0.18);
  }

  .gate[data-state='approved'] .gate-dot {
    background: var(--ok);
    box-shadow: 0 0 0 3px rgba(63, 143, 90, 0.18);
  }

  .gate[data-state='rejected'] .gate-dot {
    background: var(--stamp);
  }

  .gate-wait {
    font: 500 0.75rem / 1 var(--font-mono);
    color: var(--partial-ink);
  }

  .gate[data-state='approved'] .gate-wait {
    color: var(--ok-ink);
  }

  .gate[data-state='rejected'] .gate-wait {
    color: var(--stamp);
  }

  .gate-body {
    padding: var(--s-5);
  }

  .gate-run {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem;
    font: 400 0.9rem / 1.4 var(--font-mono);
  }

  .gate-pill {
    padding: 0.1rem 0.45rem;
    border-radius: var(--radius);
    background: var(--accent-soft);
    color: var(--accent-deep);
    font-size: 0.75rem;
  }

  .gate-run code {
    padding: 0.05rem 0.35rem;
    border-radius: 3px;
    background: var(--paper-2);
  }

  .gate-meta {
    color: var(--muted);
  }

  .gate-jobs {
    display: grid;
    gap: 0.3rem;
    margin-top: var(--s-4);
    list-style: none;
    font: 400 0.85rem / 1.4 var(--font-mono);
  }

  .gate-jobs span {
    display: inline-block;
    width: 1.2rem;
    color: var(--ok);
    font-weight: 700;
  }

  .gate-jobs .is-wait span {
    color: var(--partial);
  }

  @media (prefers-reduced-motion: no-preference) {
    .gate:not([data-state]) .is-wait span {
      animation: blink 1.2s ease-in-out infinite;
    }
    @keyframes blink {
      50% {
        opacity: 0.25;
      }
    }
  }

  .gate-form {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.6fr);
    gap: var(--s-4);
    align-items: start;
    margin-top: var(--s-5);
  }

  .gate-form label {
    display: grid;
    gap: 0.35rem;
    font: 500 0.8rem / 1.3 var(--font-mono);
  }

  .gate-form em {
    font-style: normal;
    color: var(--muted);
  }

  .gate-form input,
  .gate-form textarea {
    width: 100%;
    padding: 0.6rem 0.7rem;
    border: var(--hair) solid var(--ink);
    border-radius: var(--radius);
    background: var(--paper);
    color: var(--ink);
    font: 400 0.95rem / 1.4 var(--font-sans);
    resize: vertical;
  }

  .gate-btns {
    grid-column: 1 / -1;
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: var(--s-3);
  }

  .gate-log {
    margin-top: var(--s-3);
    text-align: right;
  }

  .gate-log:empty {
    display: none;
  }

  /* Without JS the approve link still opens a plain email. */
  :global(html:not(.js)) .gate-form label,
  :global(html:not(.js)) [data-gate-reject] {
    display: none;
  }

  @media (max-width: 40rem) {
    .gate-body {
      padding: var(--s-4);
    }
    .gate-form {
      grid-template-columns: 1fr;
    }
    .gate-btns {
      justify-content: stretch;
    }
    .gate-btns > * {
      flex: 1;
    }
  }
</style>

<script>
  const gate = document.querySelector<HTMLElement>('[data-gate]');
  if (gate) {
    const form = gate.querySelector<HTMLFormElement>('[data-gate-form]')!;
    const team = form.querySelector<HTMLInputElement>('[name="team"]')!;
    const comment = form.querySelector<HTMLTextAreaElement>('[name="comment"]')!;
    const env = gate.querySelector<HTMLElement>('[data-gate-env]')!;
    const stateEl = gate.querySelector<HTMLElement>('[data-gate-state]')!;
    const log = gate.querySelector<HTMLElement>('[data-gate-log]')!;
    const approve = gate.querySelector<HTMLAnchorElement>('[data-gate-approve]')!;
    const email = gate.dataset.email!;

    const slug = (s: string) => s.trim().toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '') || 'your-team';
    const buildHref = () => {
      const t = team.value.trim();
      const subject = `Approved: ${t ? `${t} ` : ''}would like to talk about a role`;
      const body = [comment.value.trim(), '', '— sent from the approval gate on rafifdzaky.com'].join('\n').trim();
      return `mailto:${email}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
    };

    team.addEventListener('input', () => {
      env.textContent = slug(team.value);
      approve.href = buildHref();
    });
    comment.addEventListener('input', () => (approve.href = buildHref()));
    form.addEventListener('submit', (e) => e.preventDefault());

    approve.addEventListener('click', () => {
      if (gate.dataset.state === 'rejected') return; // the button now sends feedback
      approve.href = buildHref();
      gate.dataset.state = 'approved';
      stateEl.textContent = 'Approved · deploying';
      log.textContent = `approved by you · opening your mail client → ${email}`;
    });

    gate.querySelector('[data-gate-reject]')!.addEventListener('click', () => {
      gate.dataset.state = 'rejected';
      stateEl.textContent = 'Rejected';
      log.textContent = 'Rejected. Fair enough. Feedback still helps: tell me what was missing and I will re-run with it.';
      approve.textContent = 'Send feedback instead';
      approve.href = `mailto:${email}?subject=${encodeURIComponent('Feedback on your portfolio')}`;
    });
  }
</script>
