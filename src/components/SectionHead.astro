---
// Section marker styled like a departures-board gate label.
interface Props {
  index: string;
  label: string;
  title: string;
  id?: string;
}
const { index, label, title, id } = Astro.props;
---

<div class="sh">
  <p class="sh-gate">
    <span class="sh-no">Gate {index}</span><span class="sh-label">{label}</span>
  </p>
  <h2 id={id}>{title}</h2>
  <slot />
</div>

<style>
  .sh-gate {
    display: inline-flex;
    align-items: stretch;
    border: var(--rule) solid var(--ink);
    border-radius: var(--radius);
    font: 500 0.75rem / 1 var(--font-mono);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    overflow: hidden;
  }

  .sh-no {
    padding: 0.45rem 0.6rem;
    background: var(--ink);
    color: var(--paper);
  }

  .sh-label {
    padding: 0.45rem 0.7rem;
    background: var(--card);
  }

  h2 {
    margin-top: var(--s-4);
    max-width: 22ch;
    font-size: var(--step-3);
  }

  .sh > :global(p:not(.sh-gate)) {
    margin-top: var(--s-4);
  }
</style>
