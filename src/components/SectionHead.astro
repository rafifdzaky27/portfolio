---
// Section marker styled like a departures-board gate label.
interface Props {
  index: string;
  label: string;
  title: string;
  id?: string;
}
const { index, label, title, id } = Astro.props;
---

<div class="sh">
  <p class="sh-gate">
    <span class="sh-no">Gate {index}</span><span class="sh-label">{label}</span>
  </p>
  <h2 id={id}>{title}</h2>
  <slot />
</div>

<style>
  .sh-gate {
    display: flex;
    gap: 0.6em;
    font: 500 0.85rem / 1.4 var(--font-mono);
    color: var(--muted);
  }

  .sh-no::after {
    content: '·';
    margin-left: 0.6em;
  }

  h2 {
    margin-top: var(--s-4);
    max-width: 22ch;
    font-size: var(--step-3);
  }

  .sh > :global(p:not(.sh-gate)) {
    margin-top: var(--s-4);
  }
</style>
