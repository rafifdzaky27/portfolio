---
// Animated release route. Every service goes through the same pipeline;
// ~60% continue straight to deploy, production releases wait at a manual
// approval gate (dispatched and confirmed by Rafif). Generalized: no hosts,
// repos or paths. SMIL animateMotion, paused under reduced motion and via the
// Hold button. The visually-hidden list carries the same content for AT.
const desc =
  'Release route: commit, build, test and package run for every service. The route then splits. About 60 percent of services continue automatically to deploy. Production releases stop at a manual gate where Rafif dispatches and confirms the run. Both lanes merge at deploy, then a health check verifies the release and monitoring keeps watching.';
---

<figure class="rr">
  <div class="rr-head">
    <p class="kicker">Route map · how a release travels</p>
    <button class="rr-hold" type="button" aria-pressed="false">
      <span class="on">❚❚ Hold</span><span class="off">▶ Resume</span>
    </button>
  </div>

  <!-- wide -->
  <svg class="rr-svg rr-wide" viewBox="0 0 1060 270" role="img" aria-label={desc}>
    <defs>
      <path id="rr-auto" d="M60 135 H470 C520 135 520 60 570 60 H690 C740 60 740 135 790 135 H1000"></path>
      <path id="rr-manual" d="M60 135 H470 C520 135 520 210 570 210 H690 C740 210 740 135 790 135 H1000"></path>
    </defs>
    <path class="lane lane-trunk" d="M60 135 H470 M790 135 H1000"></path>
    <path class="lane lane-auto" d="M470 135 C520 135 520 60 570 60 H690 C740 60 740 135 790 135"></path>
    <path class="lane lane-manual" d="M470 135 C520 135 520 210 570 210 H690 C740 210 740 135 790 135"></path>

    <g class="stops">
      <g transform="translate(60 135)"><circle r="9"></circle><text y="34">commit</text></g>
      <g transform="translate(180 135)"><circle r="9"></circle><text y="34">build</text></g>
      <g transform="translate(300 135)"><circle r="9"></circle><text y="34">test</text></g>
      <g transform="translate(420 135)"><circle r="9"></circle><text y="34">package</text></g>
      <g transform="translate(830 135)"><circle r="9"></circle><text y="34">deploy</text></g>
      <g transform="translate(915 135)"><circle r="9"></circle><text y="34">verify</text></g>
      <g transform="translate(1000 135)"><circle r="9" class="end"></circle><text y="34">watch</text></g>
    </g>
    <g class="gate" transform="translate(630 210)">
      <rect x="-13" y="-13" width="26" height="26" rx="4"></rect>
      <path d="M-5 0 L-1 4 L6 -4"></path>
      <text y="36">approve</text>
    </g>
    <text class="lane-label" x="630" y="40">auto · ~60% of services</text>
    <text class="lane-label" x="630" y="262">production · dispatched &amp; confirmed by me</text>

    <circle class="pkt pkt-auto" r="7">
      <animateMotion dur="6s" repeatCount="indefinite" calcMode="linear"><mpath href="#rr-auto"></mpath></animateMotion>
    </circle>
    <circle class="pkt pkt-manual" r="7">
      <animateMotion dur="10s" repeatCount="indefinite" calcMode="linear" keyPoints="0;0;0.6;0.6;1" keyTimes="0;0.15;0.5;0.7;1"
        ><mpath href="#rr-manual"></mpath></animateMotion
      >
    </circle>
  </svg>

  <!-- narrow -->
  <svg class="rr-svg rr-narrow" viewBox="0 0 340 640" role="img" aria-label={desc}>
    <defs>
      <path id="rr-auto-v" d="M50 30 V600"></path>
      <path id="rr-manual-v" d="M50 30 V255 C50 300 190 285 190 330 V390 C190 435 50 420 50 465 V600"></path>
    </defs>
    <path class="lane lane-trunk" d="M50 30 V255 M50 465 V600"></path>
    <path class="lane lane-auto" d="M50 255 V465"></path>
    <path class="lane lane-manual" d="M50 255 C50 300 190 285 190 330 V390 C190 435 50 420 50 465"></path>
    <g class="stops v">
      <g transform="translate(50 30)"><circle r="9"></circle><text x="24" y="5">commit</text></g>
      <g transform="translate(50 100)"><circle r="9"></circle><text x="24" y="5">build</text></g>
      <g transform="translate(50 170)"><circle r="9"></circle><text x="24" y="5">test</text></g>
      <g transform="translate(50 240)"><circle r="9"></circle><text x="24" y="5">package</text></g>
      <g transform="translate(50 480)"><circle r="9"></circle><text x="24" y="5">deploy</text></g>
      <g transform="translate(50 540)"><circle r="9"></circle><text x="24" y="5">verify</text></g>
      <g transform="translate(50 600)"><circle r="9" class="end"></circle><text x="24" y="5">watch</text></g>
    </g>
    <g class="gate v" transform="translate(190 360)">
      <rect x="-13" y="-13" width="26" height="26" rx="4"></rect>
      <path d="M-5 0 L-1 4 L6 -4"></path>
      <text x="24" y="5">approve</text>
    </g>
    <text class="lane-label" x="68" y="365">auto</text>
    <text class="lane-label" x="68" y="382">~60%</text>
    <text class="lane-label" x="214" y="398">production</text>
    <text class="lane-label" x="214" y="415">by me</text>
    <circle class="pkt pkt-auto" r="7">
      <animateMotion dur="6s" repeatCount="indefinite"><mpath href="#rr-auto-v"></mpath></animateMotion>
    </circle>
    <circle class="pkt pkt-manual" r="7">
      <animateMotion dur="10s" repeatCount="indefinite" calcMode="linear" keyPoints="0;0;0.56;0.56;1" keyTimes="0;0.15;0.5;0.7;1"
        ><mpath href="#rr-manual-v"></mpath></animateMotion
      >
    </circle>
  </svg>

  <ol class="visually-hidden">
    <li>Commit, build, test and package run for every service.</li>
    <li>About 60% of services then deploy automatically.</li>
    <li>Production releases wait at a manual gate: I dispatch and confirm the run.</li>
    <li>Both lanes deploy, a health check verifies the release, and monitoring keeps watching.</li>
  </ol>

  <figcaption class="meta">
    Generalized from my GitHub Actions workflows. Every service uses the pipeline; only the trigger differs.
  </figcaption>
</figure>

<style>
  .rr {
    padding: var(--s-5);
    border: var(--rule) solid var(--ink);
    border-radius: var(--radius-ticket);
    background: var(--card);
  }

  .rr-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--s-3);
    margin-bottom: var(--s-3);
  }

  .rr-hold {
    padding: 0.4rem 0.6rem;
    border: var(--hair) solid var(--line-strong);
    border-radius: var(--radius);
    background: transparent;
    color: var(--muted);
    font: 500 0.75rem / 1 var(--font-mono);
    cursor: pointer;
  }

  .rr-hold:hover {
    border-color: var(--ink);
    color: var(--ink);
  }

  .rr-hold .off,
  .rr-hold[aria-pressed='true'] .on {
    display: none;
  }

  .rr-hold[aria-pressed='true'] .off {
    display: inline;
  }

  :global(html:not(.js)) .rr-hold {
    display: none;
  }

  .rr-svg {
    width: 100%;
    height: auto;
    overflow: visible;
  }

  .rr-narrow {
    display: none;
    max-width: 22rem;
    margin-inline: auto;
  }

  .lane {
    fill: none;
    stroke-width: 2;
  }

  .lane-trunk {
    stroke: var(--ink);
  }

  .lane-auto {
    stroke: var(--accent);
  }

  .lane-manual {
    stroke: var(--ink);
    stroke-dasharray: 6 6;
  }

  .stops circle {
    fill: var(--card);
    stroke: var(--ink);
    stroke-width: 2;
  }

  .stops circle.end {
    fill: var(--accent);
    stroke: var(--accent);
  }

  text {
    font-family: var(--font-mono);
    font-size: 15px;
    fill: var(--ink);
    text-anchor: middle;
  }

  .v text,
  .rr-narrow .lane-label {
    text-anchor: start;
  }

  .lane-label {
    font-size: 13px;
    fill: var(--muted);
  }

  .gate rect {
    fill: var(--card);
    stroke: var(--stamp);
    stroke-width: 2;
  }

  .gate path {
    fill: none;
    stroke: var(--stamp);
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .gate text {
    fill: var(--stamp);
  }

  .pkt {
    stroke: var(--card);
    stroke-width: 3;
  }

  .pkt-auto {
    fill: var(--accent);
  }

  .pkt-manual {
    fill: var(--ink);
  }

  figcaption {
    margin-top: var(--s-3);
  }

  @media (max-width: 44rem) {
    .rr-wide {
      display: none;
    }
    .rr-narrow {
      display: block;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .pkt,
    .rr-hold {
      display: none;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('.rr').forEach((fig) => {
    const svgs = [...fig.querySelectorAll<SVGSVGElement>('svg')];
    const btn = fig.querySelector<HTMLButtonElement>('.rr-hold')!;
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');

    const set = (held: boolean) => {
      svgs.forEach((s) => (held ? s.pauseAnimations() : s.unpauseAnimations()));
      btn.setAttribute('aria-pressed', String(held));
    };

    if (reduce.matches) set(true);
    btn.addEventListener('click', () => set(btn.getAttribute('aria-pressed') !== 'true'));

    // Don't spend cycles animating while the route is off-screen.
    if ('IntersectionObserver' in window) {
      new IntersectionObserver((entries) => {
        if (btn.getAttribute('aria-pressed') === 'true' || reduce.matches) return;
        entries.forEach((e) => svgs.forEach((s) => (e.isIntersecting ? s.unpauseAnimations() : s.pauseAnimations())));
      }).observe(fig);
    }
  });
</script>
