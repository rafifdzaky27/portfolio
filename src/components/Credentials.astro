---
import { Image } from 'astro:assets';
import { credentials } from '../data/profile';
---

<ul class="creds">
  {
    credentials.map((c, i) => (
      <li class="cred">
        <p class="cred-name">{c.name}</p>
        <p class="meta">
          {c.issuer} · {c.period}
        </p>
        {c.image ? (
          <button class="cred-open" type="button" data-cert={i} aria-haspopup="dialog">
            View certificate
          </button>
        ) : (
          <p class="cred-note">no certificate shown</p>
        )}
      </li>
    ))
  }
</ul>

{
  credentials.map(
    (c, i) =>
      c.image && (
        <dialog class="cert-dialog" data-cert-dialog={i} aria-label={`${c.name} certificate`}>
          <div class="cert-bar">
            <p>
              <strong>{c.name}</strong> <span class="meta">· {c.issuer} · ID numbers blurred</span>
            </p>
            <button class="cert-close" type="button" data-close>
              Close <span aria-hidden="true">✕</span>
            </button>
          </div>
          <Image src={c.image} alt={c.alt ?? c.name} widths={[640, 1000, 1400]} sizes="(max-width: 60rem) 94vw, 60rem" loading="lazy" />
        </dialog>
      ),
  )
}

<style>
  .creds {
    display: grid;
    gap: var(--s-3);
    list-style: none;
  }

  .cred {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    grid-template-areas: 'name btn' 'meta btn';
    align-items: center;
    column-gap: var(--s-3);
    padding-bottom: var(--s-3);
    border-bottom: var(--hair) solid var(--line);
  }

  .cred-name {
    grid-area: name;
    font-weight: 600;
    line-height: 1.3;
  }

  .cred .meta {
    grid-area: meta;
  }

  .cred-open,
  .cred-note {
    grid-area: btn;
  }

  .cred-note {
    font: 400 0.72rem / 1.3 var(--font-mono);
    color: var(--muted);
  }

  .cred-open {
    padding: 0.45rem 0.65rem;
    border: var(--hair) solid var(--ink);
    border-radius: var(--radius);
    background: var(--card);
    color: var(--ink);
    font: 500 0.75rem / 1 var(--font-mono);
    white-space: nowrap;
    cursor: pointer;
  }

  .cred-open:hover {
    background: var(--ink);
    color: var(--paper);
  }

  .cert-dialog {
    width: min(60rem, 94vw);
    max-height: 92vh;
    padding: 0;
    border: var(--rule) solid var(--ink);
    border-radius: var(--radius-ticket);
    background: var(--card);
    color: var(--ink);
  }

  .cert-dialog::backdrop {
    background: rgba(31, 42, 46, 0.6);
  }

  .cert-bar {
    position: sticky;
    top: 0;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--s-3);
    padding: var(--s-3) var(--s-4);
    border-bottom: var(--hair) solid var(--line);
    background: var(--card);
  }

  .cert-close {
    padding: 0.45rem 0.7rem;
    border: var(--hair) solid var(--ink);
    border-radius: var(--radius);
    background: var(--card);
    font: 500 0.8rem / 1 var(--font-mono);
    cursor: pointer;
  }

  .cert-dialog :global(img) {
    width: 100%;
    height: auto;
  }
</style>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-cert]').forEach((btn) => {
    const dialog = document.querySelector<HTMLDialogElement>(`[data-cert-dialog="${btn.dataset.cert}"]`);
    if (!dialog) return;
    btn.addEventListener('click', () => dialog.showModal());
    dialog.querySelector('[data-close]')?.addEventListener('click', () => dialog.close());
    // Click on the backdrop closes it.
    dialog.addEventListener('click', (e) => {
      if (e.target === dialog) dialog.close();
    });
    dialog.addEventListener('close', () => btn.focus());
  });
</script>
