---
// "Branch r" mark: one git-branch stroke that is also a lowercase r, with a
// green status dot. Same 24-unit grid, 5.5 corner radius and 1.8 stroke as the
// Pit Wall On-Call icon, so the two read as one family. public/favicon.svg uses
// the same geometry.
interface Props {
  size?: number;
  title?: string;
}
const { size = 28, title } = Astro.props;
---

<svg
  class="logo-mark"
  viewBox="0 0 24 24"
  width={size}
  height={size}
  role={title ? 'img' : undefined}
  aria-hidden={title ? undefined : 'true'}
>
  {title && <title>{title}</title>}
  <rect width="24" height="24" rx="5.5" fill="#1f2329"></rect>
  <g fill="none" stroke="#ffffff" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
    <path d="M8.5 18.5V6.5"></path>
    <path d="M8.5 13c0-3.6 2.4-5.5 6-5.5"></path>
  </g>
  <circle cx="16.6" cy="7.5" r="2.1" fill="#73bf69"></circle>
</svg>
